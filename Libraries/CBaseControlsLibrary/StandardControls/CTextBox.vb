    Public Function GetValue(Of T)() As Object
        Return CalculateValue(GetType(T))
    End Function

    ' Use this when the caller needs to distinguish invalid input from zero.
    ' A blank nullable value succeeds with Nothing; a blank non-nullable value fails.
    Public Function TryGetValue(Of T)(ByRef value As T) As Boolean
        value = Nothing
        Dim result As Object = Nothing
        If Not TryCalculateValue(GetType(T), result) Then Return False
        If result IsNot Nothing Then value = DirectCast(result, T)
        Return True
    End Function

    Public Function CalculateValue(objDataType)
        Dim requestedType = TryCast(objDataType, Type)
        If requestedType Is Nothing Then Return Text
        Dim result As Object = Nothing
        If TryCalculateValue(requestedType, result) Then Return result

        ' Preserve the existing GetValue fallback for invalid non-empty input.
        ' Validation remains the presenter's responsibility; TryGetValue reports failure.
        Dim targetType = If(Nullable.GetUnderlyingType(requestedType), requestedType)
        Select Case targetType
            Case GetType(Short), GetType(Integer), GetType(Long), GetType(Decimal),
                 GetType(Boolean), GetType(DateTime), GetType(Single), GetType(Double),
                 GetType(Byte), GetType(SByte), GetType(UInteger), GetType(ULong), GetType(UShort)
                Return Activator.CreateInstance(targetType)
        End Select
        Return Text
    End Function

    Private Function TryCalculateValue(requestedType As Type, ByRef result As Object) As Boolean
        result = Nothing
        Dim underlyingType = Nullable.GetUnderlyingType(requestedType)
        Dim targetType = If(underlyingType, requestedType)
        Dim textValue = Text
        If targetType Is GetType(String) OrElse targetType Is GetType(Object) Then
            result = textValue
            Return True
        End If
        If underlyingType IsNot Nothing AndAlso String.IsNullOrWhiteSpace(textValue) Then Return True

        Dim culture = CultureInfo.CurrentCulture
        ' Number accepts grouping and an all-zero fractional part for integer fields.
        ' This preserves inputs such as 123.00 without exception-driven parsing.
        Select Case targetType
            Case GetType(Short)
                Dim value As Short
                Dim valid = Short.TryParse(textValue, NumberStyles.Number, culture, value)
                result = value
                Return valid
            Case GetType(Integer)
                Dim value As Integer
                Dim valid = Integer.TryParse(textValue, NumberStyles.Number, culture, value)
                result = value
                Return valid
            Case GetType(Long)
                Dim value As Long
                Dim valid = Long.TryParse(textValue, NumberStyles.Number, culture, value)
                result = value
                Return valid
            Case GetType(Decimal)
                Dim value As Decimal
                Dim valid = Decimal.TryParse(textValue, NumberStyles.Number, culture, value)
                result = value
                Return valid
            Case GetType(Boolean)
                Dim value As Boolean
                Dim valid = Boolean.TryParse(textValue, value)
                result = value
                Return valid
            Case GetType(DateTime)
                Dim value As DateTime
                Dim valid = DateTime.TryParse(textValue, culture, DateTimeStyles.None, value)
                result = value
                Return valid
            Case GetType(Single)
                Dim value As Single
                Dim valid = Single.TryParse(textValue, NumberStyles.Float Or NumberStyles.AllowThousands, culture, value)
                result = value
                Return valid
            Case GetType(Double)
                Dim value As Double
                Dim valid = Double.TryParse(textValue, NumberStyles.Float Or NumberStyles.AllowThousands, culture, value)
                result = value
                Return valid
            Case GetType(Byte)
                Dim value As Byte
                Dim valid = Byte.TryParse(textValue, NumberStyles.Number, culture, value)
                result = value
                Return valid
            Case GetType(SByte)
                Dim value As SByte
                Dim valid = SByte.TryParse(textValue, NumberStyles.Number, culture, value)
                result = value
                Return valid
            Case GetType(Char)
                Dim value As Char
                Dim valid = Char.TryParse(textValue, value)
                result = value
                Return valid
            Case GetType(UInteger)
                Dim value As UInteger
                Dim valid = UInteger.TryParse(textValue, NumberStyles.Number, culture, value)
                result = value
                Return valid
            Case GetType(ULong)
                Dim value As ULong
                Dim valid = ULong.TryParse(textValue, NumberStyles.Number, culture, value)
                result = value
                Return valid
            Case GetType(UShort)
                Dim value As UShort
                Dim valid = UShort.TryParse(textValue, NumberStyles.Number, culture, value)
                result = value
                Return valid
        End Select
        Return False
    End Function

