    Public Sub UpdateDisplayOnlyControl()
        ' DisplayOnly is also used by the presenter for security restrictions.
        ' AlwaysEditable overrides view mode, but cannot override DisplayOnly.
        [ReadOnly] = _displayOnly OrElse Not (_editingMode OrElse _alwaysEditable)
        UpdateControlColors()
        UpdateMenuEditState()
    End Sub

    Private Sub UpdateControlColors()
        If Not [ReadOnly] Then
            ForeColor = GlobalVariables.DefaultFormControlForegroundColor
            BackColor = GlobalVariables.DefaultFormControlBackgroundColor
        Else
            ForeColor = GlobalVariables.DefaultFormControlReadOnlyForegroundColor
            BackColor = GlobalVariables.DefaultFormControlReadOnlyBackgroundColor
        End If
    End Sub

