    Public Overrides Property ContextMenuStrip As ContextMenuStrip
        Get
            ' The designer keeps the inherited Nothing default. Runtime access
            ' creates the owned menu once, including access for shortcut handling.
            If Not _customContextMenuAssigned AndAlso Not _disposingTextBox AndAlso
                Not Disposing AndAlso Not IsDisposed AndAlso Not IsTextBoxDesignTime() Then
                EnsureDefaultContextMenu()
            End If
            Return MyBase.ContextMenuStrip
        End Get
        Set(value As ContextMenuStrip)
            _customContextMenuAssigned = True
            MyBase.ContextMenuStrip = value
        End Set
    End Property

    Private Sub EnsureDefaultContextMenu()
        If _contextMenuStrip1 IsNot Nothing AndAlso Not _contextMenuStrip1.IsDisposed Then
            If MyBase.ContextMenuStrip IsNot _contextMenuStrip1 Then MyBase.ContextMenuStrip = _contextMenuStrip1
            Return
        End If

        _contextMenuStrip1 = New ContextMenuStrip()
        _menuItemFind = CreateMenuItem(_textFind, Keys.Control Or Keys.F, AddressOf MenuItemFind_Click)
        _menuItemUndo = CreateMenuItem(_textUndo, Keys.Control Or Keys.Z, AddressOf MenuItemUndo_Click)
        _menuItemCut = CreateMenuItem(_textCut, Keys.Control Or Keys.X, AddressOf MenuItemCut_Click)
        _menuItemCopy = CreateMenuItem(_textCopy, Keys.Control Or Keys.C, AddressOf MenuItemCopy_Click)
        _menuItemPaste = CreateMenuItem(_textPaste, Keys.Control Or Keys.V, AddressOf MenuItemPaste_Click)
        _menuItemDelete = CreateMenuItem(_textDelete, Keys.Delete, AddressOf MenuItemDelete_Click)
        _menuItemSelectAll = CreateMenuItem(_textSelectAll, Keys.Control Or Keys.A, AddressOf MenuItemSelectAll_Click)
        _contextMenuStrip1.Items.AddRange(New ToolStripItem() {
            _menuItemFind, _menuItemUndo, New ToolStripSeparator(),
            _menuItemCut, _menuItemCopy, _menuItemPaste, _menuItemDelete,
            New ToolStripSeparator(), _menuItemSelectAll})
        UpdateMenuEditState()
        MyBase.ContextMenuStrip = _contextMenuStrip1
    End Sub

    Private Shared Function CreateMenuItem(caption As String, shortcut As Keys, handler As EventHandler) As ToolStripMenuItem
        Dim fallback = GetBuiltInCaption(caption, CultureInfo.CurrentUICulture)
        Return New ToolStripMenuItem(fallback, Nothing, handler) With {.ShortcutKeys = shortcut, .Tag = caption}
    End Function

    Private Shared Function GetBuiltInCaption(caption As String, culture As CultureInfo) As String
        Try
            Return If(MenuCaptionResources.GetString(caption, culture), caption)
        Catch ex As MissingManifestResourceException
            Return caption
        Catch ex As MissingSatelliteAssemblyException
            Return caption
        End Try
    End Function

    Private Function IsTextBoxDesignTime() As Boolean
        If LicenseManager.UsageMode = LicenseUsageMode.Designtime Then Return True
        Dim control As Control = Me
        While control IsNot Nothing
            If control.Site IsNot Nothing AndAlso control.Site.DesignMode Then Return True
            control = control.Parent
        End While
        Return False
    End Function

    Private Sub UpdateMenuCaptions()
        Dim culture = CultureInfo.CurrentUICulture
        Dim fallbacks As New Dictionary(Of String, String)(StringComparer.OrdinalIgnoreCase)
        For Each item As ToolStripItem In _contextMenuStrip1.Items
            Dim caption = TryCast(item.Tag, String)
            If caption IsNot Nothing Then fallbacks(caption) = GetBuiltInCaption(caption, culture)
        Next
        Dim captions = MessagingLibrary.ControlCaptionTranslations.GetCaptions(fallbacks, culture, IsTextBoxDesignTime())
        _contextMenuStrip1.RightToLeft = If(culture.TextInfo.IsRightToLeft, RightToLeft.Yes, RightToLeft.No)
        For Each item As ToolStripItem In _contextMenuStrip1.Items
            Dim caption = TryCast(item.Tag, String)
            If caption IsNot Nothing Then item.Text = captions(caption)
        Next
    End Sub

    Private ReadOnly Property CanEditText As Boolean
        Get
            Return Enabled AndAlso Not [ReadOnly] AndAlso Not DisplayOnly AndAlso (EditingMode OrElse AlwaysEditable)
        End Get
    End Property

    Private Sub UpdateMenuEditState()
        If _menuItemFind Is Nothing OrElse _disposingTextBox Then Return
        Dim canEdit = CanEditText
        Dim hasSelection = SelectionLength > 0
        Dim canCopy = hasSelection AndAlso Not UseSystemPasswordChar AndAlso PasswordChar = ChrW(0)
        _menuItemFind.Enabled = FindEnabled
        _menuItemUndo.Enabled = canEdit AndAlso CanUndo
        _menuItemCut.Enabled = canEdit AndAlso canCopy
        _menuItemCopy.Enabled = canCopy
        _menuItemPaste.Enabled = canEdit AndAlso _clipboardContainsText
        _menuItemDelete.Enabled = canEdit AndAlso hasSelection
        _menuItemSelectAll.Enabled = TextLength > 0 AndAlso SelectionLength < TextLength
    End Sub

    Protected Sub ContextHandler(sender As Object, e As EventArgs)
        If _customContextMenuAssigned OrElse _disposingTextBox OrElse IsDisposed Then Return
        EnsureDefaultContextMenu()
        UpdateMenuCaptions()
        Try
            _clipboardContainsText = Clipboard.ContainsText()
        Catch ex As System.Runtime.InteropServices.ExternalException
            ' A busy clipboard must not prevent the rest of the menu from opening.
            _clipboardContainsText = False
        End Try
        UpdateMenuEditState()
    End Sub

    Protected Overrides Sub Dispose(disposing As Boolean)
        _disposingTextBox = True
        Try
            If disposing AndAlso _contextMenuStrip1 IsNot Nothing Then
                If MyBase.ContextMenuStrip Is _contextMenuStrip1 Then MyBase.ContextMenuStrip = Nothing
                _contextMenuStrip1.Dispose()
                _contextMenuStrip1 = Nothing
            End If
        Finally
            Try
                MyBase.Dispose(disposing)
            Finally
                If disposing AndAlso _ownedFont IsNot Nothing Then
                    _ownedFont.Dispose()
                    _ownedFont = Nothing
                End If
            End Try
        End Try
    End Sub

    Private Sub MenuItemFind_Click()
        If FindEnabled Then
            Dim myForm = FindForm()
            Dim pnt As Point
            Dim searchForm = New CFindForm(Me)
            Dim screenRectangle As Rectangle
            Dim formLocation As Point
            screenRectangle = Screen.PrimaryScreen.WorkingArea
            searchForm.StartPosition = FormStartPosition.Manual
            pnt = myForm.PointToScreen(Location)
            If formLocation.Y + searchForm.Height > screenRectangle.Height Then
                formLocation.Y = pnt.Y - searchForm.Height + Height
            End If
            FieldName = Name.Substring(3)
            searchForm.Location = formLocation
            Dim x = Invoker.InvokeFunction(myForm, "GetFieldType", {FieldName})
            FindDataType = GetObjectDataType(x)
            searchForm.SetFieldDescription(GetControlDescription(FieldName))
            searchForm.ShowDialog()
            searchForm.Dispose()
            Invoker.InvokeFunction(myForm, "FindFieldNew", {Me})
        Else
            AATM.Libraries.MessagingLibrary.Messaging.Show(True, "MsgNothingToFind")
        End If
    End Sub

    Private Sub MenuItemCut_Click()
        If CanEditText Then
            Cut()
        Else
            MessagingLibrary.Messaging.Show(True, "MsgOperationNotAvailableInViewMode")
        End If
    End Sub

    Private Sub MenuItemCopy_Click()
        Copy()
    End Sub

    Private Sub MenuItemPaste_Click()
        If CanEditText Then
            Paste()
        Else
            MessagingLibrary.Messaging.Show(True, "MsgOperationNotAvailableInViewMode")
        End If
    End Sub

    Private Sub MenuItemSelectAll_Click()
        SelectAll()
    End Sub

    Private Sub MenuItemUndo_Click()
        If CanEditText Then
            If CanUndo Then Undo()
        Else
            MessagingLibrary.Messaging.Show(True, "MsgOperationNotAvailableInViewMode")
        End If
    End Sub

    Private Sub MenuItemDelete_Click()
        If CanEditText Then
            ' Paste(String) replaces the selection without accessing the clipboard
            ' and, unlike assigning SelectedText, preserves the native undo buffer.
            If SelectionLength > 0 Then MyBase.Paste(String.Empty)
        Else
            MessagingLibrary.Messaging.Show(True, "MsgOperationNotAvailableInViewMode")
        End If
    End Sub

    Protected Overrides Sub OnKeyDown(e As KeyEventArgs)
        ' Existing handlers (including composite editors) get first use of the key.
        MyBase.OnKeyDown(e)
        If e.Handled OrElse e.SuppressKeyPress OrElse e.KeyData <> Keys.Enter OrElse
            AcceptsReturn OrElse TypeOf Me Is IDataGridViewEditingControl Then Return
        Dim form = FindForm()
        ' Let normal dialog processing keep ownership of a form's default button.
        If form Is Nothing OrElse form.AcceptButton IsNot Nothing Then Return
        form.SelectNextControl(Me, True, True, True, True)
        e.Handled = True
        e.SuppressKeyPress = True
    End Sub

    Public Function ValueChanged()
        If Text = _oldValue Then
            Return False
        End If
        Return True
    End Function

    Public Function GetDecimalValue() As Decimal
        If Text <> "" Then
            Return Convert.ToDecimal(Text)
        Else
            Return 0D
        End If
    End Function

End Class
