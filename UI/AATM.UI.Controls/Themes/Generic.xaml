<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:AATM.UI.Controls"
                    xmlns:controls="clr-namespace:AATM.UI.Controls;assembly=AATM.UI.Controls">

    <!-- keep your existing -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/AATM.UI.Controls;component/Resources/FilteringComboBoxStyle.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Light / Dark base colors -->
    <Color x:Key="LightHover">#F2F4F7</Color>
    <Color x:Key="LightSelected">#E6F2FF</Color>
    <Color x:Key="DarkHover">#2A2A2A</Color>
    <Color x:Key="DarkSelected">#303B47</Color>

    <SolidColorBrush x:Key="ComboBackground" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}"/>
    <SolidColorBrush x:Key="ComboForeground" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}"/>
    <SolidColorBrush x:Key="ComboBorder" Color="{DynamicResource {x:Static SystemColors.ControlDarkColorKey}}"/>
    <SolidColorBrush x:Key="PopupBackground" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}"/>
    <SolidColorBrush x:Key="ComboHover" Color="#F2F4F7"/>
    <SolidColorBrush x:Key="ComboPressed" Color="#E6E8EB"/>

    <Style TargetType="{x:Type local:SmartComboBox}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SmartComboBox}">
                    <Grid>
                        <!-- main input area -->
                        <Border x:Name="PART_Border"
                                Background="{DynamicResource ComboBackground}"
                                CornerRadius="6"
                                BorderBrush="{DynamicResource ComboBorder}"
                                BorderThickness="1">
                            <Grid>
                                <TextBox x:Name="PART_TextBox"
                                         Margin="0,0,36,0"
                                         Padding="8,4"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="{DynamicResource ComboForeground}"
                                         VerticalContentAlignment="Center"
                                         FontSize="14"/>

                                <TextBlock x:Name="PART_Placeholder"
                                           Text="{TemplateBinding Placeholder}"
                                           Foreground="#999"
                                           Margin="12,0,36,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"/>

                                <!-- dropdown button -->
                                <Button x:Name="PART_Button"
                                        Width="34"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand">
                                    <Grid>
                                        <Rectangle Fill="Transparent" />
                                        <Path x:Name="PART_Arrow"
                                              Data="M0,0 L4,4 L8,0 Z"
                                              Fill="{DynamicResource ComboForeground}"
                                              Width="10"
                                              Height="6"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="0"/>
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="btn"
                                                                Background="Transparent"
                                                                CornerRadius="0,6,6,0">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="btn" Property="Background" Value="{DynamicResource ComboHover}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="btn" Property="Background" Value="{DynamicResource ComboPressed}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- dropdown -->
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=PART_Border}"
                               AllowsTransparency="True"
                               StaysOpen="False"
                               Width="{Binding ActualWidth, ElementName=PART_Border}">
                            <Border Background="{DynamicResource PopupBackground}"
                                    CornerRadius="0,0,6,6"
                                    BorderBrush="{DynamicResource ComboBorder}"
                                    BorderThickness="1"
                                    Opacity="1"
                                    RenderTransformOrigin="0.5,0">
                                <Border.RenderTransform>
                                    <TranslateTransform Y="-5"/>
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25"/>
                                </Border.Effect>

                                <Grid>
                                    <!-- list -->
                                    <ListBox x:Name="PART_ListBox"
                                             MinHeight="40"
                                             MaxHeight="300"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             VirtualizingStackPanel.IsVirtualizing="True"
                                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                                             SnapsToDevicePixels="True"
                                             DisplayMemberPath="Display">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="8,3"/>
                                                <Setter Property="FontSize" Value="14"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="{DynamicResource ComboForeground}"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="4"
                                                                    Margin="2,1">
                                                                <ContentPresenter Margin="6,0"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#F5F7FA"/>
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter Property="Background" Value="#E6F2FF"/>
                                                                    <Setter Property="Foreground" Value="#0066CC"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>

                                    <!-- busy indicator -->
                                    <TextBlock x:Name="PART_BusyText"
                                               Text="Searching..."
                                               Foreground="#999"
                                               FontStyle="Italic"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsBusy, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                            <Setter TargetName="PART_BusyText" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsBusy, RelativeSource={RelativeSource TemplatedParent}}" Value="False">
                            <Setter TargetName="PART_BusyText" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
