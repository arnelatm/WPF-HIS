<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:AATM.UI.Controls;assembly=AATM.UI.Controls"
                    xmlns:local="clr-namespace:AATM.UI.Controls">

    <!-- Merge existing resource dictionaries from this assembly -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/AATM.UI.Controls;component/Resources/FilteringComboBoxStyle.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ===================================================== -->
    <!-- SMART COMBOBOX - LIGHT/DARK AUTO THEME AND ANIMATION -->
    <!-- ===================================================== -->

    <!-- Light mode palette -->
    <Color x:Key="LightBackground">#FFFFFFFF</Color>
    <Color x:Key="LightBorder">#D0D7DE</Color>
    <Color x:Key="LightForeground">#202124</Color>
    <Color x:Key="LightHover">#F2F4F7</Color>
    <Color x:Key="LightSelected">#E6F2FF</Color>

    <!-- Dark mode palette -->
    <Color x:Key="DarkBackground">#1E1E1E</Color>
    <Color x:Key="DarkBorder">#3A3A3A</Color>
    <Color x:Key="DarkForeground">#F1F1F1</Color>
    <Color x:Key="DarkHover">#2A2A2A</Color>
    <Color x:Key="DarkSelected">#303B47</Color>

    <!-- Theme-aware brushes -->
    <SolidColorBrush x:Key="ComboBackground" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}"/>
    <SolidColorBrush x:Key="ComboForeground" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}"/>
    <SolidColorBrush x:Key="ComboBorder" Color="{DynamicResource {x:Static SystemColors.ControlDarkColorKey}}"/>
    <SolidColorBrush x:Key="ComboHover" Color="#F2F4F7"/>
    <SolidColorBrush x:Key="ComboPressed" Color="#E6E8EB"/>
    <SolidColorBrush x:Key="PopupBackground" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}"/>

    <Style TargetType="{x:Type local:SmartComboBox}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SmartComboBox}">
                    <Grid>
                        <!-- Outer border -->
                        <Border x:Name="PART_Border"
                                Background="{DynamicResource ComboBackground}"
                                CornerRadius="6"
                                BorderBrush="{DynamicResource ComboBorder}"
                                BorderThickness="1">
                            <Grid>
                                <!-- Editable TextBox -->
                                <TextBox x:Name="PART_TextBox"
                                         Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                         Margin="0,0,36,0"
                                         Padding="8,4"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="{DynamicResource ComboForeground}"
                                         VerticalContentAlignment="Center"
                                         FontSize="14"/>

                                <!-- Placeholder -->
                                <TextBlock x:Name="PART_Placeholder"
                                           Text="{TemplateBinding Placeholder}"
                                           Foreground="#999"
                                           Margin="12,0,36,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"/>

                                <!-- Dropdown Button -->
                                <Button x:Name="PART_Button"
                                        Width="34"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand">
                                    <Grid>
                                        <Rectangle Fill="Transparent" />
                                        <Path x:Name="PART_Arrow"
                                              Data="M0,0 L4,4 L8,0 Z"
                                              Fill="{DynamicResource ComboForeground}"
                                              Width="10"
                                              Height="6"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="0"/>
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="arrowBorder"
                                                                Background="Transparent"
                                                                CornerRadius="0,6,6,0">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="arrowBorder" Property="Background" Value="#F2F4F7"/>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="arrowBorder" Property="Background" Value="#E6E8EB"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Dropdown Popup -->
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=PART_Border}"
                               AllowsTransparency="True"
                               StaysOpen="False"
                               Width="{Binding ActualWidth, ElementName=PART_Border}">
                            <Border Background="{DynamicResource PopupBackground}"
                                    CornerRadius="0,0,6,6"
                                    BorderBrush="{DynamicResource ComboBorder}"
                                    BorderThickness="1"
                                    Opacity="0"
                                    RenderTransformOrigin="0.5,0">
                                <Border.RenderTransform>
                                    <TranslateTransform Y="-5"/>
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25"/>
                                </Border.Effect>

                                <!-- Virtualized ListBox for large datasets -->
                                <ListBox x:Name="PART_ListBox"
                                         MinHeight="40"
                                         MaxHeight="300"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                                         SnapsToDevicePixels="True">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="8,3"/>
                                            <Setter Property="FontSize" Value="14"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{DynamicResource ComboForeground}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border Background="{TemplateBinding Background}"
                                                                CornerRadius="4"
                                                                Margin="2,1">
                                                            <ContentPresenter HorizontalAlignment="Left"
                                                                              VerticalAlignment="Center"
                                                                              Margin="6,0"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <!-- Light Mode Hover -->
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#F5F7FA"/>
                                                            </Trigger>
                                                            <!-- Light Mode Selected -->
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter Property="Background" Value="#E6F2FF"/>
                                                                <Setter Property="Foreground" Value="#0066CC"/>
                                                            </Trigger>
                                                            <!-- Dark Mode Hover -->
                                                            <MultiTrigger>
                                                                <MultiTrigger.Conditions>
                                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                                    <Condition Property="IsEnabled" Value="True"/>
                                                                </MultiTrigger.Conditions>
                                                                <Setter Property="Background" Value="#2A2A2A"/>
                                                                <Setter Property="Foreground" Value="#F1F1F1"/>
                                                            </MultiTrigger>
                                                            <!-- Dark Mode Selected -->
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter Property="Background" Value="#303B47"/>
                                                                <Setter Property="Foreground" Value="#80C8FF"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
