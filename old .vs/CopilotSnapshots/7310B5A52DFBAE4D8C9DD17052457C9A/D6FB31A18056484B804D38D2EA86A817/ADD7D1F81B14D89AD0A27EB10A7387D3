        // Helper method to find parent controls in the visual tree
        private static T? FindParent<T>(DependencyObject child) where T : DependencyObject
        {
            var parent = VisualTreeHelper.GetParent(child);
            while (parent != null)
            {
                if (parent is T typedParent)
                    return typedParent;
                
                parent = VisualTreeHelper.GetParent(parent);
            }
            return null;
        }

        private void CmbEmployeeIdNo_SelectionChanged(object? sender, SelectionChangedEventArgs e)
        {
            try
            {
                if (e.AddedItems != null && e.AddedItems.Count > 0 && e.AddedItems[0] is EmployeeLookupDto emp)
                {
                    if (ViewModel.SelectedUser != null)
                        ViewModel.SelectedUser.EmployeeIdNo = emp.IdNo;

                    ViewModel.EmployeeFilterText = emp.DisplayText ?? string.Empty;
                }
                else
                {
                    if (cmbEmployeeIdNo.SelectedItem == null)
                        ViewModel.EmployeeFilterText = string.Empty;
                }

                // Do not synchronously Refresh on the UI thread. Postpone clearing the temporary filter
                // to allow the ComboBox to commit the selection and update its editable text immediately.
                var view = CollectionViewSource.GetDefaultView(cmbEmployeeIdNo.ItemsSource);
                if (view != null)
                {
                    Dispatcher.BeginInvoke((Action)(() =>
                    {
                        try
                        {
                            view.Filter = null;
                            view.Refresh();
                        }
                        catch { }
                    }), System.Windows.Threading.DispatcherPriority.Background);
                }

                // Close dropdown (optional) — keep light-weight
                if (cmbEmployeeIdNo.IsDropDownOpen)
                    cmbEmployeeIdNo.IsDropDownOpen = false;
            }
            catch
            {
                // keep UI resilient
            }
        }

        // -- updated PreviewKeyDown: avoid Keyboard.ClearFocus and postpone refresh --
        private void CmbEmployeeIdNo_PreviewKeyDown(object? sender, KeyEventArgs e)
        {
            try
            {
                // Handle Backspace/Delete to clear full selection — allow WinForms-like clearing behavior
                if (e.Key == Key.Back || e.Key == Key.Delete)
                {
                    var tb = FindVisualChild<TextBox>(cmbEmployeeIdNo);
                    if (tb != null)
                    {
                        // If entire text is selected, clear it and reset VM filter
                        if (tb.SelectionLength > 0 && tb.SelectionLength == (tb.Text?.Length ?? 0))
                        {
                            tb.Clear();
                            ViewModel.EmployeeFilterText = string.Empty;
                            cmbEmployeeIdNo.SelectedItem = null;

                            // Clear any temporary filter and refresh
                            var view = CollectionViewSource.GetDefaultView(cmbEmployeeIdNo.ItemsSource);
                            if (view != null)
                            {
                                Dispatcher.BeginInvoke((Action)(() =>
                                {
                                    try { view.Filter = null; view.Refresh(); } catch { }
                                }), System.Windows.Threading.DispatcherPriority.Background);
                            }

                            e.Handled = true;
                            return;
                        }
                    }
                }

                if (e.Key == Key.Enter)
                {
                    if (cmbEmployeeIdNo.SelectedItem is EmployeeLookupDto selectedEmp)
                    {
                        if (ViewModel.SelectedUser != null)
                            ViewModel.SelectedUser.EmployeeIdNo = selectedEmp.IdNo;

                        ViewModel.EmployeeFilterText = selectedEmp.DisplayText ?? string.Empty;
                    }
                    else
                    {
                        var typed = cmbEmployeeIdNo.Text?.Trim() ?? string.Empty;
                        if (!string.IsNullOrEmpty(typed))
                        {
                            var match = ViewModel.AvailableEmployees.FirstOrDefault(em =>
                                (!string.IsNullOrEmpty(em.DisplayText) && string.Equals(em.DisplayText, typed, StringComparison.OrdinalIgnoreCase))
                                || (!string.IsNullOrEmpty(em.EmployeeCode) && string.Equals(em.EmployeeCode, typed, StringComparison.OrdinalIgnoreCase))
                                || (!string.IsNullOrEmpty(em.EmployeeName) && string.Equals(em.EmployeeName, typed, StringComparison.OrdinalIgnoreCase))
                            );

                            if (match != null)
                            {
                                if (ViewModel.SelectedUser != null)
                                    ViewModel.SelectedUser.EmployeeIdNo = match.IdNo;

                                ViewModel.EmployeeFilterText = match.DisplayText ?? string.Empty;
                                cmbEmployeeIdNo.SelectedValue = match.IdNo;
                            }
                        }
                    }

                    var view = CollectionViewSource.GetDefaultView(cmbEmployeeIdNo.ItemsSource);
                    if (view != null)
                    {
                        Dispatcher.BeginInvoke((Action)(() =>
                        {
                            try
                            {
                                view.Filter = null;
                                view.Refresh();
                            }
                            catch { }
                        }), System.Windows.Threading.DispatcherPriority.Background);
                    }

                    if (cmbEmployeeIdNo.IsDropDownOpen)
                        cmbEmployeeIdNo.IsDropDownOpen = false;

                    // Avoid forcing focus changes like Keyboard.ClearFocus() here.
                    e.Handled = true;
                }
                else if (e.Key == Key.Escape)
                {
                    if (cmbEmployeeIdNo.IsDropDownOpen)
                        cmbEmployeeIdNo.IsDropDownOpen = false;

                    cmbEmployeeIdNo.SelectedItem = null;
                    ViewModel.EmployeeFilterText = string.Empty;

                    var view = CollectionViewSource.GetDefaultView(cmbEmployeeIdNo.ItemsSource);
                    if (view != null)
                    {
                        Dispatcher.BeginInvoke((Action)(() =>
                        {
                            try
                            {
                                view.Filter = null;
                                view.Refresh();
                            }
                            catch { }
                        }), System.Windows.Threading.DispatcherPriority.Background);
                    }

                    e.Handled = true;
                }
            }
            catch
            {
                // ignore
            }
        }
