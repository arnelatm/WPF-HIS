            txtRecordCount.Text = ViewModel.Users.Count.ToString();
        }

        private void CmbEmployeeIdNo_TextChanged(object sender, TextChangedEventArgs e)
        {
            // Removed focus guard so clearing text always clears the filter immediately
            if (e.Changes.Count == 0) return;

            // Keep the VM property in sync (used by other parts of UI)
            ViewModel.EmployeeFilterText = cmbEmployeeIdNo.Text ?? string.Empty;

            // Apply a temporary filter to the collection view over the full dataset (AvailableEmployees)
            var view = CollectionViewSource.GetDefaultView(cmbEmployeeIdNo.ItemsSource);
            if (view == null) return;

            var filter = ViewModel.EmployeeFilterText?.Trim() ?? string.Empty;

            // If there is no text, clear any filter so the full list is available immediately
            if (string.IsNullOrEmpty(filter))
            {
                view.Filter = null;
                view.Refresh();

                // Automatically open the dropdown so the full list is visible when text is cleared
                if (!cmbEmployeeIdNo.IsDropDownOpen)
                    cmbEmployeeIdNo.IsDropDownOpen = true;

                return;
            }

            // Otherwise apply the typed filter
            view.Filter = o =>
            {
                if (o is not EmployeeLookupDto emp) return false;
                // match DisplayText, EmployeeName or EmployeeCode
                return (!string.IsNullOrEmpty(emp.DisplayText) && emp.DisplayText.IndexOf(filter, StringComparison.OrdinalIgnoreCase) >= 0)
                    || (!string.IsNullOrEmpty(emp.EmployeeName) && emp.EmployeeName.IndexOf(filter, StringComparison.OrdinalIgnoreCase) >= 0)
                    || (!string.IsNullOrEmpty(emp.EmployeeCode) && emp.EmployeeCode.IndexOf(filter, StringComparison.OrdinalIgnoreCase) >= 0);
            };
            view.Refresh();

            // Ensure dropdown opens while typing
            if (!cmbEmployeeIdNo.IsDropDownOpen) cmbEmployeeIdNo.IsDropDownOpen = true;
        }

        private void CmbEmployeeIdNo_DropDownClosed(object? sender, EventArgs e)
        {
            // Always clear the temporary filter when editing (drop-down closed) so ItemsSource shows full data next time.
            var view = CollectionViewSource.GetDefaultView(cmbEmployeeIdNo.ItemsSource);
            if (view != null)
            {
                view.Filter = null;
                view.Refresh();
            }

            // NOTE: Do NOT clear the editable text here. Allow the user to type arbitrary text like a WinForms DropDownComboBox.
            // Previous behavior cleared EmployeeFilterText when no item was selected which prevented manual edits from persisting.
            // Keep the typed text in ViewModel.EmployeeFilterText so it remains after the dropdown closes.
        }

