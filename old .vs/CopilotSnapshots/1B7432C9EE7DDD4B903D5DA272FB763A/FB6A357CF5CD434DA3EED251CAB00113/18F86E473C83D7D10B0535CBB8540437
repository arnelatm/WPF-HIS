using System.Windows;
using System.Windows.Controls;
using System.Windows.Controls.Primitives;
using System.Windows.Data;
using System.Windows.Input;
using System.Windows.Media;

namespace AATM.App.HisWpf.Behaviors
{
    /// <summary>
    /// Enables keyboard navigation in editable ComboBox dropdowns while maintaining filter capability.
    /// </summary>
    public static class ComboBoxKeyboardBehavior
    {
        public static readonly DependencyProperty EnableKeyboardNavigationProperty =
            DependencyProperty.RegisterAttached(
                "EnableKeyboardNavigation",
                typeof(bool),
                typeof(ComboBoxKeyboardBehavior),
                new PropertyMetadata(false, OnEnableKeyboardNavigationChanged));

        public static bool GetEnableKeyboardNavigation(DependencyObject obj) => (bool)obj.GetValue(EnableKeyboardNavigationProperty);
        public static void SetEnableKeyboardNavigation(DependencyObject obj, bool value) => obj.SetValue(EnableKeyboardNavigationProperty, value);

        // Track highlighted index
        private static readonly DependencyProperty HighlightedIndexProperty =
            DependencyProperty.RegisterAttached("HighlightedIndex", typeof(int), typeof(ComboBoxKeyboardBehavior), new PropertyMetadata(-1));

        // Visual highlighting property that XAML triggers watch
        public static readonly DependencyProperty IsKeyboardHighlightedProperty =
            DependencyProperty.RegisterAttached("IsKeyboardHighlighted", typeof(bool), typeof(ComboBoxKeyboardBehavior), new PropertyMetadata(false));

        public static bool GetIsKeyboardHighlighted(DependencyObject obj) => (bool)obj.GetValue(IsKeyboardHighlightedProperty);
        public static void SetIsKeyboardHighlighted(DependencyObject obj, bool value) => obj.SetValue(IsKeyboardHighlightedProperty, value);

        private static void OnEnableKeyboardNavigationChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
        {
            if (d is not ComboBox comboBox || (bool)e.NewValue == false) return;

            // Attach directly to ComboBox PreviewKeyDown - this is the SIMPLEST approach
            comboBox.PreviewKeyDown += ComboBox_PreviewKeyDown;
            comboBox.DropDownOpened += ComboBox_DropDownOpened;
            comboBox.DropDownClosed += ComboBox_DropDownClosed;
        }

        private static void ComboBox_PreviewKeyDown(object sender, KeyEventArgs e)
        {
            if (sender is not ComboBox comboBox) return;

            // Only handle arrow keys when dropdown is open
            if (!comboBox.IsDropDownOpen || (e.Key != Key.Down && e.Key != Key.Up)) return;

            e.Handled = true; // Prevent default behavior

            var view = CollectionViewSource.GetDefaultView(comboBox.ItemsSource);
            if (view == null || comboBox.Items.Count == 0) return;

            int currentIndex = view.CurrentPosition;
            int newIndex = currentIndex;

            if (e.Key == Key.Down)
            {
                newIndex = currentIndex < comboBox.Items.Count - 1 ? currentIndex + 1 : currentIndex;
            }
            else // Key.Up
            {
                newIndex = currentIndex > 0 ? currentIndex - 1 : currentIndex;
            }

            if (newIndex != currentIndex)
            {
                view.MoveCurrentToPosition(newIndex);
                HighlightItem(comboBox, newIndex);
            }
        }

        private static void ComboBox_DropDownOpened(object sender, EventArgs e)
        {
            if (sender is not ComboBox comboBox) return;

            comboBox.Dispatcher.BeginInvoke(new Action(() =>
            {
                var view = CollectionViewSource.GetDefaultView(comboBox.ItemsSource);
                if (view == null) return;

                int indexToHighlight = comboBox.SelectedItem != null
                    ? comboBox.Items.IndexOf(comboBox.SelectedItem)
                    : (comboBox.Items.Count > 0 ? 0 : -1);

                if (indexToHighlight >= 0)
                {
                    view.MoveCurrentToPosition(indexToHighlight);
                    HighlightItem(comboBox, indexToHighlight);
                }
            }), System.Windows.Threading.DispatcherPriority.Background);
        }

        private static void ComboBox_DropDownClosed(object sender, EventArgs e)
        {
            if (sender is not ComboBox comboBox) return;
            ClearHighlight(comboBox);
        }

        private static void HighlightItem(ComboBox comboBox, int index)
        {
            if (index < 0 || index >= comboBox.Items.Count) return;

            // Clear previous
            int previousIndex = (int)comboBox.GetValue(HighlightedIndexProperty);
            if (previousIndex >= 0 && previousIndex != index)
            {
                var previousContainer = comboBox.ItemContainerGenerator.ContainerFromIndex(previousIndex) as ComboBoxItem;
                if (previousContainer != null)
                {
                    SetIsKeyboardHighlighted(previousContainer, false);
                }
            }

            // Set new
            comboBox.UpdateLayout();
            var container = comboBox.ItemContainerGenerator.ContainerFromIndex(index) as ComboBoxItem;
            if (container != null)
            {
                comboBox.SetValue(HighlightedIndexProperty, index);
                SetIsKeyboardHighlighted(container, true);
                container.BringIntoView();
            }
        }

        private static void ClearHighlight(ComboBox comboBox)
        {
            int previousIndex = (int)comboBox.GetValue(HighlightedIndexProperty);
            if (previousIndex >= 0 && previousIndex < comboBox.Items.Count)
            {
                var previousContainer = comboBox.ItemContainerGenerator.ContainerFromIndex(previousIndex) as ComboBoxItem;
                if (previousContainer != null)
                {
                    SetIsKeyboardHighlighted(previousContainer, false);
                }
            }
            comboBox.SetValue(HighlightedIndexProperty, -1);
        }
    }
}
