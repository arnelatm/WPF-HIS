using System.Windows;
using System.Windows.Controls;
using System.Windows.Input;
using System.Windows.Data;

namespace AATM.App.HisWpf.Behaviors
{
    /// <summary>
    /// Attached behavior for editable ComboBox: when the entire text is selected
    /// and the user types or presses Delete/Backspace, make sure the ComboBox
    /// does not restore its Text from SelectedItem/SelectedValue. Clears selection
    /// and updates bindings so typed input or delete works as expected.
    /// </summary>
    public static class ComboBoxClearOnFullSelectionBehavior
    {
        public static readonly DependencyProperty IsEnabledProperty = DependencyProperty.RegisterAttached(
            "IsEnabled",
            typeof(bool),
            typeof(ComboBoxClearOnFullSelectionBehavior),
            new PropertyMetadata(false, OnIsEnabledChanged));

        public static void SetIsEnabled(DependencyObject element, bool value) => element.SetValue(IsEnabledProperty, value);
        public static bool GetIsEnabled(DependencyObject element) => (bool)element.GetValue(IsEnabledProperty);

        private static void OnIsEnabledChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
        {
            if (d is not ComboBox combo) return;

            if ((bool)e.NewValue)
            {
                combo.PreviewKeyDown += Combo_PreviewKeyDown;
                combo.PreviewTextInput += Combo_PreviewTextInput;
                combo.LostFocus += Combo_LostFocus;
            }
            else
            {
                combo.PreviewKeyDown -= Combo_PreviewKeyDown;
                combo.PreviewTextInput -= Combo_PreviewTextInput;
                combo.LostFocus -= Combo_LostFocus;
            }
        }

        private static void Combo_LostFocus(object sender, RoutedEventArgs e)
        {
            if (sender is not ComboBox combo) return;
            
            // If text is empty when focus is lost, ensure SelectedValue is cleared
            if (string.IsNullOrEmpty(combo.Text))
            {
                combo.SelectedItem = null;
                combo.SelectedValue = null;
                
                var beText = combo.GetBindingExpression(ComboBox.TextProperty);
                beText?.UpdateSource();
                
                var beSel = combo.GetBindingExpression(ComboBox.SelectedValueProperty);
                beSel?.UpdateSource();
            }
        }

        private static void Combo_PreviewTextInput(object sender, TextCompositionEventArgs e)
        {
            if (sender is not ComboBox combo || !combo.IsEditable) return;

            var tb = combo.Template.FindName("PART_EditableTextBox", combo) as TextBox;
            if (tb == null) return;

            // If all text is selected, typing should replace it
            if (!string.IsNullOrEmpty(tb.Text) && tb.SelectionLength == tb.Text.Length)
            {
                // Clear bindings before allowing new text
                ClearComboBoxBindings(combo);
            }
        }

        private static void Combo_PreviewKeyDown(object sender, KeyEventArgs e)
        {
            if (sender is not ComboBox combo || !combo.IsEditable) return;

            var tb = combo.Template.FindName("PART_EditableTextBox", combo) as TextBox;
            if (tb == null) return;

            if (string.IsNullOrEmpty(tb.Text) || tb.SelectionLength != tb.Text.Length) return;

            // If the entire text is selected and user presses Delete/Backspace
            if (e.Key == Key.Delete || e.Key == Key.Back)
            {
                ClearComboBoxBindings(combo);
                e.Handled = true;
            }
        }

        private static void ClearComboBoxBindings(ComboBox combo)
        {
            // Clear all bound values
            combo.Text = string.Empty;
            combo.SelectedItem = null;
            combo.SelectedValue = null;

            // Update all bindings to ensure VM gets the changes
            var textBinding = combo.GetBindingExpression(ComboBox.TextProperty);
            textBinding?.UpdateSource();

            var selectedValueBinding = combo.GetBindingExpression(ComboBox.SelectedValueProperty);
            selectedValueBinding?.UpdateSource();

            var selectedItemBinding = combo.GetBindingExpression(ComboBox.SelectedItemProperty);
            selectedItemBinding?.UpdateSource();
        }
    }
}
