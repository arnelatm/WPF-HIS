<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:AATM.UI.Controls"
 xmlns:conv="clr-namespace:AATM.UI.Controls.Converters">

 <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

    <Style TargetType="{x:Type local:SmartComboBox}">
        <Setter Property="EnableAutoScrollPaging" Value="True"/>
        <Setter Property="MinSearchLength" Value="2"/>
        <Setter Property="ShowAllOnBlank" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SmartComboBox}">
                    <Grid>
                        <!-- Main border wraps textbox and arrow -->
                        <Border x:Name="PART_ComboBorder" BorderBrush="Gray" BorderThickness="1" CornerRadius="2" Background="White">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PART_TextBox"
                                     Grid.Column="0"
                                     VerticalAlignment="Stretch"
                                     Margin="0"
                                     Padding="4,2,4,2"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     HorizontalAlignment="Stretch"/>
                                <Button x:Name="PART_Button"
                                     Grid.Column="1"
                                     Width="24"
                                     VerticalAlignment="Stretch"
                                     Margin="0"
                                     Padding="0"
                                     Focusable="False"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Visibility="Visible">
                                    <Grid>
                                        <Path Data="M0,0 L12,0 L6,8 Z"
                                         Fill="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                                         Width="12"
                                         Height="8"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Visibility="Visible"/>
                                    </Grid>
                                </Button>
                            </Grid>
                        </Border>
                        <!-- Custom dropdown panel instead of Popup -->
                        <Grid x:Name="PART_DropDownPanel"
                          Visibility="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}"
                          Margin="0,1,0,0">
                            <Border x:Name="PART_ListBorder" Background="White" BorderBrush="Gray" BorderThickness="1"
                                 MinWidth="{Binding ActualWidth, ElementName=PART_ComboBorder}"
                                 Width="{Binding ActualWidth, ElementName=PART_ComboBorder}">
                                <DockPanel LastChildFill="True"
                                    MaxHeight="{Binding MaxDropDownHeight, RelativeSource={RelativeSource TemplatedParent}}">
                                    <TextBlock x:Name="PART_BusyText"
                                         DockPanel.Dock="Bottom"
                                         Foreground="Gray"
                                         FontStyle="Italic"
                                         Visibility="Collapsed"
                                         Margin="4,2"/>
                                    <Button x:Name="PART_LoadMore"
                                         DockPanel.Dock="Bottom"
                                         Content="Load more"
                                         Margin="4,2,4,4"
                                         Height="24"
                                         Visibility="Collapsed"
                                         IsEnabled="False"
                                         HorizontalAlignment="Stretch"/>
                                    <ListBox x:Name="PART_ListBox"
                                         IsSynchronizedWithCurrentItem="True"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.CanContentScroll="True"
                                         KeyboardNavigation.TabNavigation="Continue"
                                         MaxHeight="{Binding MaxDropDownHeight, RelativeSource={RelativeSource TemplatedParent}}"
                                         HorizontalAlignment="Stretch" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
