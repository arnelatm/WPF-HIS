<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:AATM.UI.Controls">

    <Style TargetType="{x:Type local:SmartComboBox}">
        <Setter Property="EnableAutoScrollPaging" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SmartComboBox}">
                    <Grid>
                        <!-- Overlay TextBox and Button -->
                        <TextBox x:Name="PART_TextBox"
                                 VerticalAlignment="Stretch"
                                 Margin="0"
                                 Padding="4,2,28,2" /> <!-- Extra right padding for arrow -->
                        <Button x:Name="PART_Button"
                                Width="24"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Stretch"
                                Margin="0"
                                Padding="0"
                                Focusable="False"
                                Background="Transparent"
                                BorderThickness="0">
                            <Grid>
                                <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                      Fill="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                                      Width="12"
                                      Height="8"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <!-- Popup for dropdown list -->
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               Focusable="False">
                            <Border Background="White" BorderBrush="Gray" BorderThickness="1"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:SmartComboBox}}">
                                <DockPanel LastChildFill="True"
                                           MaxHeight="{Binding MaxDropDownHeight, RelativeSource={RelativeSource TemplatedParent}}">
                                    <StackPanel DockPanel.Dock="Top">
                                        <TextBlock x:Name="PART_BusyText"
                                                   Foreground="Gray"
                                                   FontStyle="Italic"
                                                   Visibility="Collapsed"
                                                   Margin="4,2"/>
                                    </StackPanel>
                                    <!-- ScrollViewer ensures vertical scrollbar is available -->
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="True">
                                        <ListBox x:Name="PART_ListBox"
                                                 IsSynchronizedWithCurrentItem="True"
                                                 VirtualizingStackPanel.IsVirtualizing="True"
                                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                                 ScrollViewer.CanContentScroll="True"
                                                 KeyboardNavigation.TabNavigation="Continue"/>
                                    </ScrollViewer>
                                    <!-- Hide load more button completely -->
                                    <Button x:Name="PART_LoadMore"
                                            Content="Load more"
                                            Margin="4,2,4,4"
                                            Height="0"
                                            Visibility="Collapsed"
                                            IsEnabled="False"
                                            HorizontalAlignment="Stretch"/>
                                </DockPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
