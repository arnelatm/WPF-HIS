<Window x:Class="AATM.Sample"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AATM.UI.Controls;assembly=AATM.UI.Controls"
        Title="SmartComboBox SQL Demo" Height="250" Width="500">

    <StackPanel Margin="20">
        <TextBlock Text="SQL Mode ComboBox" FontWeight="Bold" Margin="0,0,0,8"/>

        <local:SmartComboBox x:Name="sqlCombo"
                         Placeholder="Search customer..."
                         UseRemoteFetch="True"
                         RemoteTake="20"
                         Height="30"
                         MaxDropDownHeight="240"
                         ConnectionString="Server=Ibn-Server;Database=IspData;User Id=iGroupAdmin;Password=igss@123;Encrypt=True;TrustServerCertificate=True;"
                         SqlQueryTemplate="SELECT IdNo, ProductCode AS Code, ProductName AS Name FROM Product WHERE ProductCode + ProductName LIKE '%' + @filter + '%' ORDER BY ProductName"
                         SelectedId="{Binding SelectedCustomerId, Mode=TwoWay}"
                         SelectedCode="{Binding SelectedCustomerCode, Mode=TwoWay}"
                         SelectedName="{Binding SelectedCustomerName, Mode=TwoWay}"
                         Margin="0,0,0,12"
                         DebounceMilliseconds="300"
                         BorderBrush="Black"
                         BorderThickness="1"/>

        <Button x:Name="btnSave" Content="Save" Height="32" Width="100" Margin="0,0,0,8"/>

        <StackPanel Margin="0,8,0,0">
            <TextBlock Text="Selected:" FontWeight="Bold"/>
            <TextBlock Text="{Binding SelectedCustomerCode}" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding SelectedCustomerName}" Margin="0,2,0,0"/>
        </StackPanel>
    </StackPanel>

</Window>