using System;
using System.Data;

namespace AATM.UI.Controls
{
    internal class ComboRecord
    {
        /// <summary>
        /// Gets or sets the raw underlying data object for this record.
        /// </summary>
        public object Raw { get; set; }
        /// <summary>
        /// Gets or sets the IdNo value for this record.
        /// </summary>
        public object IdNo { get; set; } = new object();
        /// <summary>
        /// Gets the uppercase version of the Code property for fast matching.
        /// </summary>
        public string CodeUpper { get; private set; } = string.Empty;
        /// <summary>
        /// Gets the uppercase version of the Name property for fast matching.
        /// </summary>
        public string NameUpper { get; private set; } = string.Empty;

        private string _code = string.Empty;
        private string _name = string.Empty;
        /// <summary>
        /// Gets or sets the Code value for this record.
        /// </summary>
        public string Code
        {
            get => _code;
            set
            {
                _code = value ?? string.Empty;
                CodeUpper = _code.ToUpperInvariant();
            }
        }
        /// <summary>
        /// Gets or sets the Name value for this record.
        /// </summary>
        public string Name
        {
            get => _name;
            set
            {
                _name = value ?? string.Empty;
                NameUpper = _name.ToUpperInvariant();
            }
        }
        /// <summary>
        /// Gets the display text for this record (Code - Name or Name).
        /// </summary>
        public string Display => string.IsNullOrEmpty(Code) ? Name : $"{Code} - {Name}";

        public bool Matches(string filter)
        {
            if (string.IsNullOrEmpty(filter)) return true;
            var f = filter.ToUpperInvariant();
            return CodeUpper.AsSpan().IndexOf(f.AsSpan()) >= 0 || NameUpper.AsSpan().IndexOf(f.AsSpan()) >= 0;
        }

        public override string ToString() => Display;

        public static ComboRecord FromUnknown(object obj)
        {
            if (obj == null) return null;
            if (obj is ComboRecord c) return c;

            // DataRowView mapping (support both Code/Name and ProductCode/ProductName)
            if (obj is DataRowView drv)
            {
                return new ComboRecord
                {
                    Raw = obj,
                    IdNo = TryGet(drv, "IdNo"),
                    Code = (TryGet(drv, "Code") ?? TryGet(drv, "ProductCode") ?? string.Empty).ToString(),
                    Name = (TryGet(drv, "Name") ?? TryGet(drv, "ProductName") ?? TryGet(drv, "ProductNameAra") ?? string.Empty).ToString()
                };
            }
            // DataRow mapping
            if (obj is DataRow dr)
            {
                return new ComboRecord
                {
                    Raw = obj,
                    IdNo = TryGet(dr, "IdNo"),
                    Code = (TryGet(dr, "Code") ?? TryGet(dr, "ProductCode") ?? string.Empty).ToString(),
                    Name = (TryGet(dr, "Name") ?? TryGet(dr, "ProductName") ?? TryGet(dr, "ProductNameAra") ?? string.Empty).ToString()
                };
            }

            var type = obj.GetType();
            var map = ReflectionCache.Get(type);

            // Explicit property probing for common synonyms
            object id = map.IdNoProp?.GetValue(obj);
            object code = map.CodeProp?.GetValue(obj);
            object name = map.NameProp?.GetValue(obj);

            // Handle refactored Product class (ProductCode / ProductName)
            if (code == null)
            {
                var pCodeProp = type.GetProperty("ProductCode");
                if (pCodeProp != null)
                    code = pCodeProp.GetValue(obj);
            }
            if (name == null)
            {
                var pNameProp = type.GetProperty("ProductName");
                if (pNameProp != null)
                    name = pNameProp.GetValue(obj);
                else
                {
                    var pNameAraProp = type.GetProperty("ProductNameAra");
                    if (pNameAraProp != null)
                        name = pNameAraProp.GetValue(obj);
                }
            }

            if (id != null || code != null || name != null)
            {
                return new ComboRecord
                {
                    Raw = obj,
                    IdNo = id ?? obj,
                    Code = code?.ToString() ?? string.Empty,
                    Name = name?.ToString() ?? string.Empty
                };
            }

            // Fallback generic mapping
            return new ComboRecord
            {
                Raw = obj,
                IdNo = obj,
                Code = string.Empty,
                Name = obj.ToString() ?? string.Empty
            };
        }

        private static object TryGet(DataRowView drv, string col)
        {
            try { return drv.Row.Table.Columns.Contains(col) ? drv[col] : null; } catch { return null; }
        }
        private static object TryGet(DataRow dr, string col)
        {
            try { return dr.Table.Columns.Contains(col) ? dr[col] : null; } catch { return null; }
        }
    }
}
