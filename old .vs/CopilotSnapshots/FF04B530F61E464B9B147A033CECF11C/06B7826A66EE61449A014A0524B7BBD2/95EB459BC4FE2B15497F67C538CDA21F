        private void TextBox_KeyDown(object sender, KeyEventArgs e)
        {
            if (e.Key == Key.Enter)
            {
                CommitSelection();
                e.Handled = true;
                return;
            }
        }

        private void TextBox_PreviewKeyDown(object sender, KeyEventArgs e)
        {
            if (e.Key == Key.Down || e.Key == Key.Up)
            {
                var txt = _textBox?.Text ?? string.Empty;
                _ignoreMinLengthOnce = true;
                _focusListOnSearchComplete = true;
                _pendingMoveDelta = e.Key == Key.Down ? 1 : -1;
                EnsureDropDownAndSearch(txt, forceOpen: true);

                if (_listBox != null && _currentItems.Count > 0)
                {
                    FocusListAndEnsureSelection(_pendingMoveDelta);
                    _pendingMoveDelta = 0;
                }
                e.Handled = true;
                return;
            }
            if (e.Key == Key.Enter)
            {
                CommitSelection();
                e.Handled = true;
                return;
            }
            if (e.Key == Key.Tab)
            {
                CommitSelection();
            }
        }

        private void ListBox_PreviewMouseLeftButtonUp(object sender, MouseButtonEventArgs e)
        {
            CommitSelection();
            e.Handled = true;
        }

        private void ListBox_PreviewKeyDown(object sender, KeyEventArgs e)
        {
            if (e.Key == Key.Enter)
            {
                CommitSelection();
                e.Handled = true;
                return;
            }
            if (e.Key == Key.Tab)
            {
                CommitSelection();
                return;
            }
            if (e.Key == Key.Escape)
            {
                ClosePopup();
                e.Handled = true;
                return;
            }

            // Auto-load next page when navigating beyond the last item
            if (e.Key == Key.Down)
            {
                if (_listBox != null && _currentItems.Count > 0 && _listBox.SelectedIndex >= _currentItems.Count - 1)
                {
                    if (HasNextPage && !IsBusy)
                    {
                        e.Handled = true; // prevent default selection move
                        _pagingDown = true;
                        _pendingPageDown = true;
                        var nextPage = PageIndex + 1;
                        _suppressPageIndexChanged = true;
                        PageIndex = nextPage;
                        _suppressPageIndexChanged = false;
                        // Allow paging even when below MinSearchLength (blank filter scenario)
                        _ignoreMinLengthOnce = true;
                        _ = AppendPageAsync(nextPage);
                        return;
                    }
                }
            }

            if (e.Key == Key.Up)
            {
                // When at the top of the list, move focus back to the textbox and place caret at the end
                if (_listBox != null && _listBox.SelectedIndex <= 0)
                {
                    e.Handled = true;
                    FocusTextBoxAtEnd();
                    return;
                }
            }
            // Let other navigation keys (Up/Down/PageUp/PageDown/Home/End) use default behavior
        }

        private void AttachItemsSourceObserver(IEnumerable source)
        {
            DetachItemsSourceObserver();
            if (source is INotifyCollectionChanged incc)
            {
                _itemsSourceObserver = incc;
                _itemsSourceObserver.CollectionChanged += ItemsSource_CollectionChanged;
            }
        }

        private void DetachItemsSourceObserver()
        {
            if (_itemsSourceObserver != null)
            {
                _itemsSourceObserver.CollectionChanged -= ItemsSource_CollectionChanged;
                _itemsSourceObserver = null;
            }
        }

        private void ItemsSource_CollectionChanged(object sender, NotifyCollectionChangedEventArgs e)
        {
            if (!Dispatcher.CheckAccess())
            {
                Dispatcher.Invoke(() => ItemsSource_CollectionChanged(sender, e));
                return;
            }
            BuildLocalMasterFromItemsSource();
            if (IsDropDownOpen)
            {
                _ = StartSearchAsync(_textBox?.Text ?? string.Empty);
            }
        }

        private void SyncPopupOpenState(bool open)
        {
