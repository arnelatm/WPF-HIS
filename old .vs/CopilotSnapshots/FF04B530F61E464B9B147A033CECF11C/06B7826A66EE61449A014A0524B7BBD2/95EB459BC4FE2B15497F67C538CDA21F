        public SmartComboBox()
        {
            RemoteTake = 20;
            EnableAutoScrollPaging = true;
            _autoLoadAllOnOpenActive = false;
            _currentItems.CollectionChanged += CurrentItems_CollectionChanged;
            Unloaded += SmartComboBox_Unloaded;
        }

        private void SmartComboBox_Unloaded(object sender, RoutedEventArgs e)
        {
            if (_debounce != null)
            {
                _debounce.Stop();
                _debounce.Tick -= async (_, __) => { };
                _debounce = null;
            }
            if (_scrollJumpTimer != null)
            {
                _scrollJumpTimer.Stop();
                _scrollJumpTimer.Tick -= ScrollJumpTimer_Tick;
                _scrollJumpTimer = null;
            }
            DetachItemsSourceObserver();
        }

        private void TrimPageCache()
        {
            while (_pageCache.Count > MaxPageCacheSize)
            {
                var oldestKey = _pageCache.Keys.Min();
                _pageCache.Remove(oldestKey);
            }
        }

