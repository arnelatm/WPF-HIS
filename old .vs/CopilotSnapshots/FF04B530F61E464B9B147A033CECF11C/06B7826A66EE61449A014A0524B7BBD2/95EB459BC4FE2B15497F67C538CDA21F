        public override void OnApplyTemplate()
        {
            base.OnApplyTemplate();

            _textBox = GetTemplateChild("PART_TextBox") as TextBox;
            _listBox = GetTemplateChild("PART_ListBox") as ListBox;
            _button = GetTemplateChild("PART_Button") as Button;
            _popup = GetTemplateChild("PART_Popup") as Popup;
            _busyText = GetTemplateChild("PART_BusyText") as TextBlock;
            _loadMoreButton = GetTemplateChild("PART_LoadMore") as Button;
            _listBorder = GetTemplateChild("PART_ListBorder") as Border;

            if (_listBox != null)
            {
                // Use native vertical scrollbar visuals - always visible
                ScrollViewer.SetVerticalScrollBarVisibility(_listBox, ScrollBarVisibility.Visible);
                _listBox.SizeChanged -= ListBox_SizeChanged;
                // Do not intercept mouse wheel; let ScrollViewer handle it
                _listBox.PreviewMouseWheel -= ListBox_PreviewMouseWheel;

                _listBox.ItemsSource = _currentItems;
                _listBox.PreviewMouseLeftButtonUp -= ListBox_PreviewMouseLeftButtonUp;
                _listBox.PreviewMouseLeftButtonUp += ListBox_PreviewMouseLeftButtonUp;
                _listBox.PreviewKeyDown -= ListBox_PreviewKeyDown;
                _listBox.PreviewKeyDown += ListBox_PreviewKeyDown;
                _listBox.SelectionChanged -= ListBox_SelectionChanged;
                _listBox.SelectionChanged += ListBox_SelectionChanged;

                _scrollViewer = FindDescendant<ScrollViewer>(_listBox);
                if (_scrollViewer != null)
                {
                    _scrollViewer.VerticalScrollBarVisibility = ScrollBarVisibility.Visible;
                    _scrollViewer.ScrollChanged -= ScrollViewer_ScrollChanged;
                    _scrollViewer.ScrollChanged += ScrollViewer_ScrollChanged;
                }
            }

            if (_textBox != null)
            {
                _textBox.PreviewKeyDown += TextBox_PreviewKeyDown;
                _textBox.KeyDown += TextBox_KeyDown;
                _textBox.TextChanged += TextBox_TextChanged;
            }
            if (_button != null)
            {
                _button.Click -= DropButton_Click;
                _button.Click += DropButton_Click;
            }
            if (_popup != null)
            {
                _popup.Opened -= Popup_Opened;
                _popup.Closed -= Popup_Closed;
                _popup.Opened += Popup_Opened;
                _popup.Closed += Popup_Closed;
            }

            SyncPopupOpenState(IsDropDownOpen);

            BuildLocalMasterFromItemsSource();
            TrySelectBySelectedValue();
            TrySelectBySelectedItem();
        }

        // Restored minimal handlers for native scrollbar approach
        private void Popup_Opened(object sender, EventArgs e)
        {
            if (_ignorePopupSync) return;
            IsDropDownOpen = true;
            TryAttachScrollViewer();
        }

        private void Popup_Closed(object sender, EventArgs e)
        {
            if (_ignorePopupSync) return;
            IsDropDownOpen = false;
            if (_scrollViewer != null)
            {
                _scrollViewer.ScrollChanged -= ScrollViewer_ScrollChanged;
                _scrollViewer = null;
            }
            _scrollJumpTimer?.Stop();
        }

        private void EnsureDropDownAndSearch(string txt, bool forceOpen = false)
        {
            bool shouldOpen = forceOpen || ShouldActivateDropDown(txt) || (ShowAllOnBlank && string.IsNullOrWhiteSpace(txt));
            if (!shouldOpen)
                return;

            if (forceOpen)
            {
                _lastFilter = string.Empty;
                _currentItems.Clear();
                OpenPopup();
                _ = StartSearchAsync(txt ?? string.Empty);
                return;
            }

            OpenPopup();

            if (_currentItems.Count == 0 || !string.Equals(_lastFilter, (txt ?? string.Empty).Trim(), StringComparison.Ordinal))
            {
                _ = StartSearchAsync(txt ?? string.Empty);
            }
        }

        private void TryAttachScrollViewer()
        {
            if (_listBox == null) return;
            _listBox.ApplyTemplate();
            _scrollViewer = FindDescendant<ScrollViewer>(_listBox);
            if (_scrollViewer != null)
            {
                _scrollViewer.ScrollChanged -= ScrollViewer_ScrollChanged;
                _scrollViewer.ScrollChanged += ScrollViewer_ScrollChanged;
            }
            else
            {
                _listBox.RemoveHandler(ScrollViewer.ScrollChangedEvent, (ScrollChangedEventHandler)ListBox_ScrollProxy);
                _listBox.AddHandler(ScrollViewer.ScrollChangedEvent, (ScrollChangedEventHandler)ListBox_ScrollProxy);
            }
        }

        private void ListBox_ScrollProxy(object sender, ScrollChangedEventArgs e)
        {
            if (_scrollViewer == null && e.OriginalSource is ScrollViewer sv)
            {
                _scrollViewer = sv;
                _scrollViewer.ScrollChanged -= ScrollViewer_ScrollChanged;
                _scrollViewer.ScrollChanged += ScrollViewer_ScrollChanged;
            }
            ScrollViewer_ScrollChanged(sender, e);
        }

        private void ScrollViewer_ScrollChanged(object sender, ScrollChangedEventArgs e)
        {
            if (_suppressScrollHandling) return;
            if (!IsDropDownOpen) return;
            if (IsBusy) return;
            if (!EnableAutoScrollPaging) return;
            var sv = _scrollViewer ?? e.OriginalSource as ScrollViewer;
            if (sv == null) return;

            int pageSize = EffectivePageSize;
            if (TotalCount > 0 && pageSize > 0 && sv.ScrollableHeight > 0)
            {
                double frac = Math.Clamp(sv.VerticalOffset / sv.ScrollableHeight, 0.0, 1.0);
                _pendingScrollFrac = frac;
                EnsureScrollJumpTimer();
                _scrollJumpTimer.Stop();
                _scrollJumpTimer.Interval = TimeSpan.FromMilliseconds(140);
                _scrollJumpTimer.Start();
                return;
            }

            double remaining = (sv.ExtentHeight - sv.VerticalOffset) - sv.ViewportHeight;
            bool nearBottom = remaining <= Math.Max(2.0, sv.ViewportHeight * _autoScrollPrefetchRatio);
            bool atBottom = sv.VerticalOffset >= sv.ScrollableHeight - 0.5;

            if (TotalCount > 0 && pageSize > 0 && sv.ScrollableHeight > 0)
            {
                int targetItemIndex = (int)Math.Round(_pendingScrollFrac * Math.Max(0, TotalCount - 1));
                int lastPageIndex = Math.Max(0, (int)Math.Ceiling((double)TotalCount / pageSize) - 1);
                int targetPage = targetItemIndex / Math.Max(1, pageSize);
                int withinPageIndex = targetItemIndex % Math.Max(1, pageSize);
                targetPage = Math.Max(0, Math.Min(lastPageIndex, targetPage));
                if (targetPage != PageIndex)
                {
                    _jumpingToLastPage = true;
                    _jumpTargetPage = targetPage;
                    _jumpWithinPageIndex = withinPageIndex;
                    _ignoreMinLengthOnce = true;
                    _suppressAutoSelect = true;
                    _pagingDown = false;
                    _pendingPageDown = false;
                    _pendingPageUp = false;
                    _suppressPageIndexChanged = true;
                    _suppressScrollHandling = true;
                    PageIndex = targetPage;
                    _suppressPageIndexChanged = false;
                    _ = AppendPageAsync(targetPage);
                    return;
                }
            }

            if (atBottom && HasNextPage)
            {
                if (pageSize > 0 && TotalCount > 0)
                {
                    int lastPg = Math.Max(0, (int)Math.Ceiling((double)TotalCount / pageSize) - 1);
                    if (lastPg > PageIndex)
                    {
                        _pagingDown = true;
                        _pendingPageDown = true;
                        _suppressPageIndexChanged = true;
                        PageIndex = lastPg;
                        _suppressPageIndexChanged = false;
                        _ignoreMinLengthOnce = true;
                        _suppressAutoSelect = true;
                        _jumpingToLastPage = true;
                        _jumpTargetPage = lastPg;
                        _jumpWithinPageIndex = Math.Max(0, pageSize - 1);
                        _ = AppendPageAsync(lastPg);
                        return;
                    }
                }
            }

            if (nearBottom && HasNextPage)
            {
                _pagingDown = true;
                _pendingPageDown = true;
                var nextPage = PageIndex + 1;
                _suppressPageIndexChanged = true;
                PageIndex = nextPage;
                _suppressPageIndexChanged = false;
                _ignoreMinLengthOnce = true;
                _suppressAutoSelect = true;
                _ = AppendPageAsync(nextPage);
            }
        }

