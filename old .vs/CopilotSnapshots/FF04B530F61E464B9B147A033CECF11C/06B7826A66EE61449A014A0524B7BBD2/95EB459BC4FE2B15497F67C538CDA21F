        private async Task StartSearchAsync(string filter)
        {
            var old = Interlocked.Exchange(ref _cts, new CancellationTokenSource());
            try { old?.Cancel(); }
            finally { old?.Dispose(); }
            _lastFilter = (filter ?? string.Empty).Trim();
            _currentItems.Clear();
            _pageCache.Clear();
            _forceFirstSelectionOnLoad = false;
            _lastPageIndex = 0;
            PageIndex = 0;
            HasNextPage = false;
            await RunInitialSearchAsync(_lastFilter, _cts?.Token ?? CancellationToken.None);
        }

        private async Task RunInitialSearchAsync(string filter, CancellationToken token = default)
        {
            _pageCache.Clear();
            _currentItems.Clear();
            var trimmed = (filter ?? string.Empty).Trim();
            _lastFilter = trimmed;
            _suppressPageIndexChanged = true;
            PageIndex = 0;
            _suppressPageIndexChanged = false;
            if (token.IsCancellationRequested) return;
            if (trimmed.Length < MinSearchLength && !(ShowAllOnBlank && string.IsNullOrEmpty(trimmed)) && !_ignoreMinLengthOnce)
            {
                HasNextPage = false;
                _autoLoadAllOnOpenActive = false;
                return;
            }
            if (string.IsNullOrEmpty(trimmed)) _ignoreMinLengthOnce = true;
            await AppendPageAsync(0, token);
            EnsureScrollViewerAndMaybePrefetch();
            if (_focusListOnSearchComplete)
            {
                FocusListAndEnsureSelection(_pendingMoveDelta);
                _pendingMoveDelta = 0;
            }
            if (!string.IsNullOrEmpty(trimmed)) _ignoreMinLengthOnce = false;
            _focusListOnSearchComplete = false;
        }

        private void OnPagingStateChanged()
        {
            // Using native scrollbar visuals; no special UI sync needed here.
        }

        private void EnsureScrollViewerAndMaybePrefetch()
        {
            // Minimal implementation: if content does not overflow and more pages exist, fetch next page once.
            if (!IsDropDownOpen) return;
            if (_listBox == null) return;
            if (_scrollViewer == null) TryAttachScrollViewer();
            var sv = _scrollViewer;
            if (sv == null) return;
            if (!HasNextPage) return;
            if (IsBusy) return;
            // If the list does not overflow yet, prefetch one page
            if (sv.ExtentHeight <= sv.ViewportHeight + 1)
            {
                _initialPrefetchInProgress = true;
                _suppressAutoSelect = true;
                var nextPage = PageIndex + 1;
                _pagingDown = true;
                _pendingPageDown = false;
                _suppressPageIndexChanged = true;
                PageIndex = nextPage;
                _suppressPageIndexChanged = false;
                _ignoreMinLengthOnce = true;
                _ = AppendPageAsync(nextPage).ContinueWith(t =>
                {
                    _initialPrefetchInProgress = false;
                    _suppressAutoSelect = false;
                }, TaskScheduler.FromCurrentSynchronizationContext());
            }
        }

        private void EnsureScrollJumpTimer()
        {
            if (_scrollJumpTimer != null) return;
            _scrollJumpTimer = new DispatcherTimer(DispatcherPriority.Background)
            {
                Interval = TimeSpan.FromMilliseconds(140)
            };
            _scrollJumpTimer.Tick += ScrollJumpTimer_Tick;
        }

        private void ScrollJumpTimer_Tick(object sender, EventArgs e)
        {
            _scrollJumpTimer.Stop();
            PerformProportionalJump(_pendingScrollFrac);
        }

        private void PerformProportionalJump(double frac)
        {
            if (!IsDropDownOpen) return;
            int pageSize = EffectivePageSize;
            if (TotalCount <= 0 || pageSize <= 0) return;
            int lastPageIndex = Math.Max(0, (int)Math.Ceiling((double)TotalCount / pageSize) - 1);
            frac = Math.Clamp(frac, 0.0, 1.0);
            int targetItemIndex = (int)Math.Round(frac * Math.Max(0, TotalCount - 1));
            int targetPage = targetItemIndex / Math.Max(1, pageSize);
            int withinPageIndex = targetItemIndex % Math.Max(1, pageSize);
            targetPage = Math.Max(0, Math.Min(lastPageIndex, targetPage));
            if (targetPage == PageIndex) return;

            _jumpingToLastPage = true;
            _jumpTargetPage = targetPage;
            _jumpWithinPageIndex = withinPageIndex;
            _ignoreMinLengthOnce = true;
            _suppressAutoSelect = true;
            _pagingDown = false;
            _pendingPageDown = false;
            _pendingPageUp = false;
            _suppressPageIndexChanged = true;
            _suppressScrollHandling = true;
            PageIndex = targetPage;
            _suppressPageIndexChanged = false;
            _ = AppendPageAsync(targetPage);
        }
    }
