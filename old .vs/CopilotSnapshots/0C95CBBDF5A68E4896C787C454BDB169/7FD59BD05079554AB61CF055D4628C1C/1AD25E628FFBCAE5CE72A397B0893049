using System;
using System.Windows;
using System.Windows.Controls;
using System.Windows.Data;
using System.Windows.Threading;

namespace AATM.App.HisWpf.Behaviors
{
    // Small helper to wire a ComboBox's editable text to a ViewModel filter property and
    // to centralize dropdown lifecycle (clear temporary filters when dropdown closes, etc.).
    public static class FilterableComboBoxHelper
    {
        public static readonly DependencyProperty EnableFilteringProperty =
            DependencyProperty.RegisterAttached("EnableFiltering", typeof(bool), typeof(FilterableComboBoxHelper), new PropertyMetadata(false, OnEnableFilteringChanged));

        public static void SetEnableFiltering(DependencyObject obj, bool value) => obj.SetValue(EnableFilteringProperty, value);
        public static bool GetEnableFiltering(DependencyObject obj) => (bool)obj.GetValue(EnableFilteringProperty);

        // Optional: property name on DataContext to bind to (e.g. "EmployeeFilterText")
        public static readonly DependencyProperty FilterPropertyNameProperty =
            DependencyProperty.RegisterAttached("FilterPropertyName", typeof(string), typeof(FilterableComboBoxHelper), new PropertyMetadata(null));

        public static void SetFilterPropertyName(DependencyObject obj, string? value) => obj.SetValue(FilterPropertyNameProperty, value);
        public static string? GetFilterPropertyName(DependencyObject obj) => (string?)obj.GetValue(FilterPropertyNameProperty);

        // Optional: explicit Binding to use for the Text property; if present, helper won't overwrite existing binding
        public static readonly DependencyProperty FilterTextBindingProperty =
            DependencyProperty.RegisterAttached("FilterTextBinding", typeof(BindingBase), typeof(FilterableComboBoxHelper), new PropertyMetadata(null));

        public static void SetFilterTextBinding(DependencyObject obj, BindingBase? value) => obj.SetValue(FilterTextBindingProperty, value);
        public static BindingBase? GetFilterTextBinding(DependencyObject obj) => (BindingBase?)obj.GetValue(FilterTextBindingProperty);

        private static void OnEnableFilteringChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
        {
            if (d is not ComboBox combo) return;

            combo.Loaded -= Combo_Loaded;
            combo.Loaded += Combo_Loaded;

            combo.DropDownClosed -= Combo_DropDownClosed;
            combo.DropDownClosed += Combo_DropDownClosed;

            combo.SelectionChanged -= Combo_SelectionChanged;
            combo.SelectionChanged += Combo_SelectionChanged;
        }

        private static void Combo_Loaded(object sender, RoutedEventArgs e)
        {
            if (sender is not ComboBox combo) return;
            if (!GetEnableFiltering(combo)) return;

            // If ComboBox.Text already bound, don't override
            var existing = BindingOperations.GetBindingBase(combo, TextBox.TextProperty);
            if (existing != null) return;

            // If explicit binding provided, use it
            var provided = GetFilterTextBinding(combo);
            if (provided != null)
            {
                BindingOperations.SetBinding(combo, TextBox.TextProperty, provided);
                return;
            }

            // Otherwise, try to bind to named property on DataContext
            var propName = GetFilterPropertyName(combo);
            if (!string.IsNullOrWhiteSpace(propName))
            {
                var binding = new Binding(propName) { Mode = BindingMode.TwoWay, UpdateSourceTrigger = UpdateSourceTrigger.PropertyChanged };
                BindingOperations.SetBinding(combo, TextBox.TextProperty, binding);
            }
        }

        private static void Combo_DropDownClosed(object? sender, EventArgs e)
        {
            if (sender is not ComboBox combo) return;
            if (!GetEnableFiltering(combo)) return;

            // Clear any temporary CollectionView filter on the ItemsSource so full list is available next time
            var view = System.Windows.Data.CollectionViewSource.GetDefaultView(combo.ItemsSource);
            if (view != null)
            {
                view.Filter = null;
                // Postpone refresh to keep UI responsive
                combo.Dispatcher.BeginInvoke((Action)(() => view.Refresh()), DispatcherPriority.Background);
            }

            // If nothing selected, keep text as-is for manual edits. Do not clear text here.
            // If you want to clear the bound filter property when no selection, uncomment below:
            // if (combo.SelectedItem == null) combo.SetCurrentValue(ComboBox.TextProperty, string.Empty);
        }

        private static void Combo_SelectionChanged(object? sender, SelectionChangedEventArgs e)
        {
            if (sender is not ComboBox combo) return;
            if (!GetEnableFiltering(combo)) return;

            if (e.AddedItems != null && e.AddedItems.Count > 0)
            {
                var added = e.AddedItems[0];
                if (added != null)
                {
                    var dispProp = added.GetType().GetProperty("DisplayText");
                    var display = dispProp != null ? dispProp.GetValue(added)?.ToString() : added.ToString();

                    // Set the editable text to the display value; this will propagate to bound filter property
                    combo.Dispatcher.BeginInvoke((Action)(() => combo.Text = display ?? string.Empty), DispatcherPriority.Background);
                }
            }
        }
    }
}
