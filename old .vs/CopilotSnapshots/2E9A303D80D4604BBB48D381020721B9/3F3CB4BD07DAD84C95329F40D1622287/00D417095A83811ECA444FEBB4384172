<Window x:Class="AATM.Sample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AATM.UI.Controls;assembly=AATM.UI.Controls"
        Title="SmartComboBox Demo" Height="350" Width="500">

    <StackPanel Margin="20">
        <TextBlock Text="Remote Mode ComboBox" FontWeight="Bold"/>
        <local:SmartComboBox
            x:Name="remoteCombo"
            Height="30"
            MaxDropDownHeight="240"
            Visibility="Visible"
            ItemsSource="{Binding Products}"
            SelectedId="{Binding SelectedCustomerId, Mode=TwoWay}"
            SelectedCode="{Binding SelectedCustomerCode, Mode=TwoWay}"
            SelectedName="{Binding SelectedCustomerName, Mode=TwoWay}"
            DebounceMilliseconds="300"
            BorderBrush="Black"
            BorderThickness="1"/>

        <Button x:Name="btnSave" Content="Save" Height="32" Width="100"/>

        <StackPanel>
            <TextBlock Text="Selected:" FontWeight="Bold"/>
            <TextBlock Text="{Binding SelectedCustomerCode}"/>
            <TextBlock Text="{Binding SelectedCustomerName}"/>
        </StackPanel>
    </StackPanel>

</Window>