        public override void OnApplyTemplate()
        {
            System.Diagnostics.Debug.WriteLine("[SmartComboBox] OnApplyTemplate called.");
            base.OnApplyTemplate();

            _textBox = GetTemplateChild("PART_TextBox") as TextBox;
            System.Diagnostics.Debug.WriteLine($"[SmartComboBox] _textBox is {( _textBox == null ? "null" : "not null" )}");

            _listBox = GetTemplateChild("PART_ListBox") as ListBox;
            _button = GetTemplateChild("PART_Button") as Button;
            _popup = GetTemplateChild("PART_Popup") as Popup;
            _busyText = GetTemplateChild("PART_BusyText") as TextBlock;
            _loadMoreButton = GetTemplateChild("PART_LoadMore") as Button;
            _listBorder = GetTemplateChild("PART_ListBorder") as Border;

            if (_listBox != null)
            {
                _listBox.ItemsSource = _currentItems;
                // Commit selection on mouse click and enable keyboard commit from list
                _listBox.PreviewMouseLeftButtonUp -= ListBox_PreviewMouseLeftButtonUp;
                _listBox.PreviewMouseLeftButtonUp += ListBox_PreviewMouseLeftButtonUp;
                _listBox.PreviewKeyDown -= ListBox_PreviewKeyDown;
                _listBox.PreviewKeyDown += ListBox_PreviewKeyDown;
            }

            if (_textBox != null)
            {
                _textBox.PreviewKeyDown += TextBox_PreviewKeyDown;
                _textBox.KeyDown += TextBox_KeyDown;
                _textBox.TextChanged += TextBox_TextChanged; // trigger filter on typing
                _textBox.GotFocus += (s, e) => System.Diagnostics.Debug.WriteLine("[SmartComboBox] _textBox GotFocus");
            }
            if (_button != null)
            {
                _button.Click -= DropButton_Click;
                _button.Click += DropButton_Click;
            }
            if (_popup != null)
            {
                _popup.Opened -= Popup_Opened;
                _popup.Closed -= Popup_Closed;
                _popup.Opened += Popup_Opened;
                _popup.Closed += Popup_Closed;
            }

            // Keep DP and popup in sync on template reapply
            SyncPopupOpenState(IsDropDownOpen);

            BuildLocalMasterFromItemsSource();
            TrySelectBySelectedValue();
            TrySelectBySelectedItem();
        }

        private void EnsureDebounce()
        {
            if (_debounce == null)
            {
                _debounce = new DispatcherTimer(DispatcherPriority.Background)
                {
                    Interval = TimeSpan.FromMilliseconds(Math.Max(0, DebounceMilliseconds))
                };
                _debounce.Tick += (s, e) =>
                {
                    _debounce.Stop();
                    var txt = _textBox?.Text ?? string.Empty;
                    Text = txt; // keep DP in sync for triggers

                    var trimmed = (txt ?? string.Empty).Trim();
                    if (ShowAllOnBlank && string.IsNullOrEmpty(trimmed))
                    {
                        EnsureDropDownAndSearch(trimmed, forceOpen: true);
                    }
                    else if (ShouldActivateDropDown(txt))
                    {
                        EnsureDropDownAndSearch(txt);
                    }
                    else
                    {
                        // below threshold, optionally close dropdown
                        IsDropDownOpen = false;
                    }
                };
            }
        }

        private void TextBox_TextChanged(object sender, TextChangedEventArgs e)
        {
            // Debounce filtering while typing
            EnsureDebounce();
            _debounce.Stop();
            _debounce.Interval = TimeSpan.FromMilliseconds(Math.Max(0, DebounceMilliseconds));
            _debounce.Start();
        }

        private void DropButton_Click(object sender, RoutedEventArgs e)
        {
            // Toggle behavior: close if already open
            if ((_popup?.IsOpen ?? false) || IsDropDownOpen)
            {
                ClosePopup();
                return;
            }
            _lastFilter = string.Empty; // Reset filter to force refresh
            var txt = _textBox?.Text ?? string.Empty;
            EnsureDropDownAndSearch(txt, forceOpen: true);
        }

        private void TextBox_KeyDown(object sender, KeyEventArgs e)
        {
            System.Diagnostics.Debug.WriteLine($"[SmartComboBox] TextBox_KeyDown: Key={e.Key}, IsDown={e.IsDown}, IsUp={e.IsUp}");
            if (e.Key == Key.Down)
            {
                System.Diagnostics.Debug.WriteLine("[SmartComboBox] TextBox_KeyDown DOWN ARROW PRESSED!");
            }
            // Handle commit on Enter
            if (e.Key == Key.Enter)
            {
                CommitSelection();
                e.Handled = true;
                return;
            }
        }

        private void TextBox_PreviewKeyDown(object sender, KeyEventArgs e)
        {
            System.Diagnostics.Debug.WriteLine($"[SmartComboBox] TextBox_PreviewKeyDown: Key={e.Key}, IsDown={e.IsDown}, IsUp={e.IsUp}, Handled={e.Handled}");
            if (e.Key == Key.Down || e.Key == Key.Up)
            {
                var txt = _textBox?.Text ?? string.Empty;
                // allow showing results even if below MinSearchLength and focus list after search
                _ignoreMinLengthOnce = true;
                _focusListOnSearchComplete = true;
                EnsureDropDownAndSearch(txt, forceOpen: true);

                // if items already present, move selection and focus immediately
                if (_listBox != null && _currentItems.Count >0)
                {
                    if (_listBox.SelectedIndex <0)
                        _listBox.SelectedIndex =0;
                    else
                    {
                        int delta = e.Key == Key.Down ?1 : -1;
                        int next = Math.Max(0, Math.Min(_currentItems.Count -1, _listBox.SelectedIndex + delta));
                        _listBox.SelectedIndex = next;
                    }
                    _listBox.ScrollIntoView(_listBox.SelectedItem);
                    _listBox.Focus();
                }
                e.Handled = true;
                return;
            }
            if (e.Key == Key.Enter)
            {
                CommitSelection();
                e.Handled = true;
                return;
            }
            if (e.Key == Key.Tab)
            {
                // Commit current highlight but let focus continue to next control
                CommitSelection();
                // do not set e.Handled so tab moves focus naturally
            }
        }

        private void ListBox_PreviewMouseLeftButtonUp(object sender, MouseButtonEventArgs e)
        {
            // Commit selection when user clicks an item
            CommitSelection();
            e.Handled = true;
        }

        private void ListBox_PreviewKeyDown(object sender, KeyEventArgs e)
        {
            if (e.Key == Key.Enter)
            {
                CommitSelection();
                e.Handled = true;
                return;
            }
            if (e.Key == Key.Tab)
            {
                // Commit then allow tab navigation to move focus
                CommitSelection();
                // do not mark handled
                return;
            }
            if (e.Key == Key.Escape)
            {
                ClosePopup();
                e.Handled = true;
                return;
            }
            // Let Up/Down/PageUp/PageDown/Home/End be handled by ListBox default behavior
        }

        private void EnsureDropDownAndSearch(string txt, bool forceOpen = false)
        {
            bool shouldOpen = forceOpen || ShouldActivateDropDown(txt) || (ShowAllOnBlank && string.IsNullOrWhiteSpace(txt));
            if (!shouldOpen)
                return;

            // Always reset filter and clear items if forceOpen (dropdown button pressed)
            if (forceOpen)
            {
                _lastFilter = string.Empty;
                _currentItems.Clear();
                OpenPopup();
                _ = StartSearchAsync(txt ?? string.Empty); // Always trigger search
                return;
            }

            // Open popup via DP to keep state
            OpenPopup();

            // If no items yet or filter changed, start initial search
            if (_currentItems.Count ==0 || !string.Equals(_lastFilter, (txt ?? string.Empty).Trim(), StringComparison.Ordinal))
            {
                _ = StartSearchAsync(txt ?? string.Empty);
            }
        }

        private void SyncPopupOpenState(bool open)
        {
            if (_popup == null) return;
            _ignorePopupSync = true;
            _popup.IsOpen = open;
            _ignorePopupSync = false;
        }

        private T FindDescendant<T>(DependencyObject root) where T : DependencyObject
        {
            if (root == null) return null;
            int count = VisualTreeHelper.GetChildrenCount(root);
            for (int i = 0; i < count; i++)
            {
                var child = VisualTreeHelper.GetChild(root, i);
                if (child is T t) return t;
                var result = FindDescendant<T>(child);
                if (result != null) return result;
            }
            return null;
        }

