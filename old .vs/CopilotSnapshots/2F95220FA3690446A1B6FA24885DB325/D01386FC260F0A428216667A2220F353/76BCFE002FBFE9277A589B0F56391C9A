<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:AATM.UI.Controls">

    <Style TargetType="{x:Type local:SmartComboBox}">
        <Setter Property="EnableAutoScrollPaging" Value="True"/>
        <Setter Property="MinSearchLength" Value="2"/>
        <Setter Property="ShowAllOnBlank" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SmartComboBox}">
                    <Grid>
                        <!-- Single row for textbox and button -->
                        <Grid x:Name="PART_InputRow">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PART_TextBox"
                                     Grid.Column="0"
                                     VerticalAlignment="Stretch"
                                     Margin="0"
                                     Padding="4,2,4,2"
                                     HorizontalAlignment="Stretch"/>
                            <Button x:Name="PART_Button"
                                    Grid.Column="1"
                                    Width="24"
                                    VerticalAlignment="Stretch"
                                    Margin="0"
                                    Padding="0"
                                    Focusable="False"
                                    Background="Transparent"
                                    BorderThickness="0">
                                <Grid>
                                    <Path Data="M 0 0 L 44 44 L 80 0 Z"
                                          Fill="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                                          Width="12"
                                          Height="8"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </Grid>
                        <!-- Popup for dropdown list -->
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               Focusable="False">
                            <Border x:Name="PART_ListBorder" Background="White" BorderBrush="Gray" BorderThickness="1"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                    Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=TemplatedParent}}">
                                <DockPanel LastChildFill="True"
                                           MaxHeight="{Binding MaxDropDownHeight, RelativeSource={RelativeSource TemplatedParent}}">
                                    <StackPanel DockPanel.Dock="Top">
                                        <TextBlock x:Name="PART_BusyText"
                                                   Foreground="Gray"
                                                   FontStyle="Italic"
                                                   Visibility="Collapsed"
                                                   Margin="4,2"/>
                                    </StackPanel>
                                    <!-- Use ListBox directly (do not wrap in external ScrollViewer) so virtualization works -->
                                    <ListBox x:Name="PART_ListBox"
                                             IsSynchronizedWithCurrentItem="True"
                                             VirtualizingStackPanel.IsVirtualizing="True"
                                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.CanContentScroll="True"
                                             KeyboardNavigation.TabNavigation="Continue"
                                             MaxHeight="{Binding MaxDropDownHeight, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Height" Value="24"/> <!-- Set your desired row height here -->
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                    <!-- Hide load more button completely -->
                                    <Button x:Name="PART_LoadMore"
                                            Content="Load more"
                                            Margin="4,2,4,4"
                                            Height="0"
                                            Visibility="Collapsed"
                                            IsEnabled="False"
                                            HorizontalAlignment="Stretch"/>
                                </DockPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
