<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net48;net8.0</TargetFrameworks>
		<AssemblyName>AATM.Services</AssemblyName>
		<RootNamespace>AATM.Services</RootNamespace>
		<LangVersion>latest</LangVersion>
		<Deterministic>true</Deterministic>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Contracts\AATM.Contracts\AATM.Contracts.csproj" />
		<!-- Only reference the net48 implementation when building net48 -->
		<ProjectReference Include="..\..\DataAccess\AATM.DataAccess.Sql\AATM.DataAccess.Sql.csproj" Condition="'$(TargetFramework)'=='net48'" />
		<!-- For netstandard2.0/net8.0, reference abstractions (or multi-target the Sql project too) -->
		<ProjectReference Include="..\..\DataAccess\AATM.DataAccess\AATM.DataAccess.csproj" Condition="'$(TargetFramework)'!='net48'" />
	</ItemGroup>

	<ItemGroup>
		<!-- Use Microsoft.Data.SqlClient; no System.Data.Common package -->
		<PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.1" Condition="'$(TargetFramework)'=='netstandard2.0'" />
		<PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.2" Condition="'$(TargetFramework)'=='net48'" />
		<PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.1" Condition="'$(TargetFramework)'=='net8.0'" />
		<!-- SNI is only needed on .NET Framework -->
		<PackageReference Include="Microsoft.Data.SqlClient.SNI" Version="6.0.2" Condition="'$(TargetFramework)'=='net48'" />
	</ItemGroup>
</Project>