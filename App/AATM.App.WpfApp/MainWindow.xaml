<Window x:Class="AATM.App.WpfHis.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AATM Main Menu" Height="400" Width="600">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="General" />
                <MenuItem Header="Security" />
                <MenuItem Header="Translations" />
                <MenuItem Header="Employees" />
                <MenuItem Header="Customers" />
                <MenuItem Header="Suppliers" />
            </MenuItem>
            <MenuItem Header="Edit" />
            <MenuItem Header="Masters" />
            <MenuItem Header="Transactions" />
            <MenuItem Header="Reports" />
            <MenuItem Header="Utilities" />
            <MenuItem Header="Help" >
                <Menu Height="5" Width="106"/>
            </MenuItem>
            <MenuItem Header="Switch Language">
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Translation Manager..." Click="OpenTranslationManager_Click" />
            </MenuItem>
        </Menu>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="349*"/>
                <ColumnDefinition Width="251*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Welcome to AATM System" 
                       HorizontalAlignment="Left" VerticalAlignment="Center"
                       FontSize="24" Grid.ColumnSpan="2" Margin="161,0,0,0"/>
        </Grid>
    </DockPanel>
</Window>