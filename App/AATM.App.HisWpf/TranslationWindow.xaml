<Window x:Class="AATM.App.HisWpf.TranslationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AATM.App.HisWpf"
        Title="Translation Manager"
        Height="668" Width="800"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- Progress bar row should be Auto, not fixed 50 -->
            <RowDefinition Height="Auto"/>
            <!-- DataGrid should take the remaining space -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation and CRUD Controls at the top -->
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="btnFirst" Content="|&lt;" Width="40" Margin="2"/>
            <Button x:Name="btnPrev" Content="&lt;" Width="40" Margin="2"/>
            <TextBox x:Name="txtCurrentRecord" Width="40" Margin="2" IsReadOnly="True" HorizontalContentAlignment="Center"/>
            <TextBlock Text="/" VerticalAlignment="Center" Margin="2"/>
            <TextBox x:Name="txtRecordCount" Width="40" Margin="2" IsReadOnly="True" HorizontalContentAlignment="Center"/>
            <Button x:Name="btnNext" Content=">" Width="40" Margin="2"/>
            <Button x:Name="btnLast" Content=">|" Width="40" Margin="2"/>
            <Button x:Name="btnFind" Content="Find" Width="60" Margin="10,2,2,2"/>
            <Button x:Name="btnSave" Content="Save" Width="60" Margin="10,2,2,2"/>
            <Button x:Name="btnDelete" Content="Delete" Width="60" Margin="2"/>
            <Button x:Name="btnSwitchLanguage" Content="Switch Language" Width="120" Margin="10,2,2,2"/>
        </StackPanel>

        <Label Grid.Row="1" Grid.Column="0" Content="ID" VerticalAlignment="Center" Grid.ColumnSpan="2"/>
        <TextBox Grid.Row="1" Grid.Column="2"
           Text="{Binding SelectedTranslation.ID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}" />

        <Label Grid.Row="2" Grid.Column="0" Content="Original" VerticalAlignment="Center" Grid.ColumnSpan="2"/>
        <TextBox Grid.Row="2" Grid.Column="2"
                 Text="{Binding SelectedTranslation.OriginalString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True, TargetNullValue=''}" />

        <Label Grid.Row="3" Grid.Column="0" Content="Localized" VerticalAlignment="Center" Grid.ColumnSpan="2"/>
        <TextBox Grid.Row="3" Grid.Column="2" x:Name="txtLocalizedString" Margin="0,2,0,2"
                 Text="{Binding SelectedTranslation.LocalizedString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True, TargetNullValue=''}" />

        <Label Grid.Row="4" Grid.Column="0" Content="Language" VerticalAlignment="Center" Grid.ColumnSpan="2"/>
        <ComboBox Grid.Row="4" Grid.Column="2" x:Name="cmbLanguageCode" Margin="0,2,0,2"
          ItemsSource="{Binding AvailableLanguages}"
          SelectedValue="{Binding SelectedTranslation.LanguageCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"
          SelectedValuePath="Code"
          DisplayMemberPath="Display" />

        <Label Grid.Row="5" Grid.Column="0" Content="UI Identifier" VerticalAlignment="Center" Grid.ColumnSpan="2"/>
        <TextBox Grid.Row="5" Grid.Column="2" x:Name="txtUIIdentifier" Margin="0,2,0,2"
                 Text="{Binding SelectedTranslation.UIIdentifier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True, TargetNullValue=''}" />

        <Label Grid.Row="6" Grid.Column="0" Content="Module" VerticalAlignment="Center" Grid.ColumnSpan="2"/>
        <TextBox Grid.Row="6" Grid.Column="2" x:Name="txtModuleName" Margin="0,2,0,2"
                 Text="{Binding SelectedTranslation.ModuleName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True, TargetNullValue=''}" />

        <TextBox Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" x:Name="txtErrors"
            Background="MistyRose" Foreground="DarkRed" FontWeight="Bold"
            IsReadOnly="True" Height="44" VerticalScrollBarVisibility="Auto"
            Text="{Binding ErrorText}" />

        <!-- Progress bar now in Auto-height row -->
        <ProgressBar Grid.Row="8" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />

        <!-- DataGrid now in the * row with minimal margin -->
        <DataGrid Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3" x:Name="dataGrid"
          ItemsSource="{Binding Translations}" AutoGenerateColumns="False"
          SelectedItem="{Binding SelectedTranslation, Mode=TwoWay}"
          Margin="0,5,0,10">
            <DataGrid.Columns>
                <local:ValidatedTextColumn Header="ID" Binding="{Binding ID}" Width="80"/>
                <local:ValidatedTextColumn Header="OriginalString" Binding="{Binding OriginalString}" Width="200"/>
                <local:ValidatedTextColumn Header="ModuleName" Binding="{Binding ModuleName}" Width="120"/>
                <local:ValidatedTextColumn Header="UIIdentifier" Binding="{Binding UIIdentifier}" Width="120"/>
                <local:ValidatedTextColumn Header="LanguageCode" Binding="{Binding LanguageCode}" Width="120"/>
                <local:ValidatedTextColumn Header="LocalizedString" Binding="{Binding LocalizedString}" Width="200"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>