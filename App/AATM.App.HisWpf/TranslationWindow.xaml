<Window x:Class="AATM.App.HisWpf.TranslationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Translation Manager"
        Height="611" Width="800"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Column="0" Content="Original" VerticalAlignment="Center" Grid.ColumnSpan="2"/>
        <TextBox Grid.Row="0" Grid.Column="2" x:Name="txtOriginalString" IsReadOnly="True" Margin="0,2,0,2"
                 Text="{Binding SelectedTranslation.OriginalString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <Label Grid.Row="1" Grid.Column="0" Content="Localized" VerticalAlignment="Center" Grid.ColumnSpan="2"/>
        <TextBox Grid.Row="1" Grid.Column="2" x:Name="txtLocalizedString" Margin="0,2,0,2"
                 Text="{Binding SelectedTranslation.LocalizedString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <Label Grid.Row="2" Grid.Column="0" Content="Language" VerticalAlignment="Center" Grid.ColumnSpan="2"/>
        <!-- VM exposes ObservableCollection<string> AvailableLanguages -->
        <ComboBox Grid.Row="2" Grid.Column="2" x:Name="cmbLanguageCode" Margin="0,2,0,2"
                  ItemsSource="{Binding AvailableLanguages}"
                  SelectedItem="{Binding SelectedTranslation.LanguageCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <Label Grid.Row="3" Grid.Column="0" Content="UI Identifier" VerticalAlignment="Center" Grid.ColumnSpan="2"/>
        <TextBox Grid.Row="3" Grid.Column="2" x:Name="txtUIIdentifier" Margin="0,2,0,2"
                 Text="{Binding SelectedTranslation.UIIdentifier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <Label Grid.Row="4" Grid.Column="0" Content="Module" VerticalAlignment="Center" Grid.ColumnSpan="2"/>
        <TextBox Grid.Row="4" Grid.Column="2" x:Name="txtModuleName" Margin="0,2,0,2"
                 Text="{Binding SelectedTranslation.ModuleName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" x:Name="txtErrors"
                 Background="MistyRose" Foreground="DarkRed" FontWeight="Bold"
                 IsReadOnly="True" Margin="0,5,0,1" Height="44" VerticalScrollBarVisibility="Auto"
                 Text="{Binding ErrorText}" />

        <DataGrid Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" x:Name="dataGrid"
                  ItemsSource="{Binding Translations}" AutoGenerateColumns="False"
                  SelectedItem="{Binding SelectedTranslation, Mode=TwoWay}"
                  Margin="0,39,0,30" Height="315">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="80"/>
                <DataGridTextColumn Header="OriginalString" Binding="{Binding OriginalString}" Width="200"/>
                <DataGridTextColumn Header="ModuleName" Binding="{Binding ModuleName}" Width="120"/>
                <DataGridTextColumn Header="UIIdentifier" Binding="{Binding UIIdentifier}" Width="120"/>
                <DataGridTextColumn Header="LanguageCode" Binding="{Binding LanguageCode}" Width="120"/>
                <DataGridTextColumn Header="LocalizedString" Binding="{Binding LocalizedString}" Width="200"/>
                <DataGridTextColumn Header="CreationDate" Binding="{Binding CreationDate}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>