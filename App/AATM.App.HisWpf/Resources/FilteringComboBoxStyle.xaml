<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:AATM.App.HisWpf.Behaviors">
	<!-- Reusable style for editable ComboBoxes that should use filtering + clear-on-full-selection -->
	<Style x:Key="FilteringComboBoxStyle" TargetType="ComboBox">
		<Setter Property="IsEditable" Value="True"/>
		<Setter Property="IsTextSearchEnabled" Value="False"/>
		<Setter Property="StaysOpenOnEdit" Value="True"/>
		<Setter Property="IsSynchronizedWithCurrentItem" Value="False"/>
		<Setter Property="ItemContainerStyle" Value="{StaticResource KeyboardNavigableComboBoxItemStyle}"/>
		<!-- enable behaviors by default; per-control MasterItemsSource/ItemsSource remain bound individually -->
		<Setter Property="behaviors:FilteredComboBoxBehavior.IsEnabled" Value="True"/>
		<Setter Property="behaviors:ComboBoxClearOnFullSelectionBehavior.IsEnabled" Value="True"/>
		<!-- default debounce (can be overridden per-control) -->
		<Setter Property="behaviors:FilteredComboBoxBehavior.FilterDebounceMilliseconds" Value="120"/>
	</Style>

	<!-- Grid-specific filtering ComboBox style:
         - Based on the general FilteringComboBoxStyle
         - Forces ItemsPanel virtualization and re-affirms behavior defaults so edit-template ComboBoxes reliably get the attached behaviors.
         - Keyed so it can be referenced directly if needed, but will also be used implicitly within DataGrid by UserWindow.xaml.
    -->
	<Style x:Key="GridFilteringComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource FilteringComboBoxStyle}">
		<Setter Property="ItemsPanel">
			<Setter.Value>
				<ItemsPanelTemplate>
					<VirtualizingStackPanel IsItemsHost="True"
                                            VirtualizingStackPanel.IsVirtualizing="True"
                                            VirtualizingStackPanel.VirtualizationMode="Recycling"/>
				</ItemsPanelTemplate>
			</Setter.Value>
		</Setter>

		<!-- Re-assert behaviors so editing templates get them consistently -->
		<Setter Property="behaviors:FilteredComboBoxBehavior.IsEnabled" Value="True"/>
		<Setter Property="behaviors:ComboBoxClearOnFullSelectionBehavior.IsEnabled" Value="True"/>
		<Setter Property="behaviors:FilteredComboBoxBehavior.FilterDebounceMilliseconds" Value="120"/>
	</Style>
</ResourceDictionary>