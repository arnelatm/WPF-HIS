<Window x:Class="AATM.App.HisWpf.UserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AATM.App.HisWpf"
        Title="User Manager"
        Height="668" Width="800"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation and CRUD Controls at the top -->
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="btnFirst" Content="|&lt;" Width="40" Margin="2"/>
            <Button x:Name="btnPrev" Content="&lt;" Width="40" Margin="2"/>
            <TextBox x:Name="txtCurrentRecord" Width="40" Margin="2" IsReadOnly="True" HorizontalContentAlignment="Center"/>
            <TextBlock Text="/" VerticalAlignment="Center" Margin="2"/>
            <TextBox x:Name="txtRecordCount" Width="40" Margin="2" IsReadOnly="True" HorizontalContentAlignment="Center"/>
            <Button x:Name="btnNext" Content=">" Width="40" Margin="2"/>
            <Button x:Name="btnLast" Content=">|" Width="40" Margin="2"/>
            <Button x:Name="btnFind" Content="Find" Width="60" Margin="10,2,2,2"/>
            <Button x:Name="btnResetFilter" Content="Reset" Width="60" Margin="2"/>
            <Button x:Name="btnSave" Content="Save" Width="60" Margin="10,2,2,2"/>
            <Button x:Name="btnDelete" Content="Delete" Width="60" Margin="2"/>
			<Button x:Name="btnSwitchLanguage" Content="🌐" Width="28" Height="28" ToolTip="Switch language" />
        </StackPanel>

        <Label Grid.Row="1" Grid.Column="0" Content="IdNo" VerticalAlignment="Center" Grid.ColumnSpan="2"/>
        <TextBox Grid.Row="1" Grid.Column="2"
           Text="{Binding SelectedUser.IdNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}" />

        <Label Grid.Row="2" Grid.Column="0" Content="User Name" VerticalAlignment="Center" Grid.ColumnSpan="2"/>
        <TextBox Grid.Row="2" Grid.Column="2"
                 Text="{Binding SelectedUser.UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True, TargetNullValue=''}" />

        <Label Grid.Row="3" Grid.Column="0" Content="User Code" VerticalAlignment="Center" Grid.ColumnSpan="2"/>
        <TextBox Grid.Row="3" Grid.Column="2"
                 Text="{Binding SelectedUser.UserCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True, TargetNullValue=''}" />

        <Label Grid.Row="4" Grid.Column="0" Content="Password" VerticalAlignment="Center" Grid.ColumnSpan="2"/>
        <TextBox Grid.Row="4" Grid.Column="2"
                 Text="{Binding SelectedUser.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True, TargetNullValue=''}" />

        <Label Grid.Row="5" Grid.Column="0" Content="Employee ID" VerticalAlignment="Center" Grid.ColumnSpan="2"/>
        <TextBox Grid.Row="5" Grid.Column="2"
                 Text="{Binding SelectedUser.EmployeeIdNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True, TargetNullValue=''}" />

        <Label Grid.Row="6" Grid.Column="0" Content="Security Group ID" VerticalAlignment="Center" Grid.ColumnSpan="2"/>
        <TextBox Grid.Row="6" Grid.Column="2"
                 Text="{Binding SelectedUser.SecurityGroupIDNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True, TargetNullValue=''}" />

        <Label Grid.Row="7" Grid.Column="0" Content="Full Name" VerticalAlignment="Center" Grid.ColumnSpan="2"/>
        <TextBox Grid.Row="7" Grid.Column="2"
                 Text="{Binding SelectedUser.FullName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True, TargetNullValue=''}" />

        <Label Grid.Row="8" Grid.Column="0" Content="Full Name (Arabic)" VerticalAlignment="Center" Grid.ColumnSpan="2"/>
        <TextBox Grid.Row="8" Grid.Column="2"
                 Text="{Binding SelectedUser.FullNameAra, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True, TargetNullValue=''}" />

        <Label Grid.Row="9" Grid.Column="0" Content="Security Level" VerticalAlignment="Center" Grid.ColumnSpan="2"/>
        <TextBox Grid.Row="9" Grid.Column="2"
                 Text="{Binding SelectedUser.SecurityLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True, TargetNullValue=''}" />

        <!-- Progress bar row -->
        <ProgressBar Grid.Row="10" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />

        <!-- DataGrid now in the * row with minimal margin -->
        <DataGrid Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="3" x:Name="dataGrid"
          ItemsSource="{Binding Users}" AutoGenerateColumns="False"
          SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
          Margin="0,5,0,10">
            <DataGrid.Columns>
                <local:ValidatedTextColumn Header="IdNo" Binding="{Binding IdNo}" Width="80"/>
                <local:ValidatedTextColumn Header="User Name" Binding="{Binding UserName}" Width="120"/>
                <local:ValidatedTextColumn Header="User Code" Binding="{Binding UserCode}" Width="100"/>
                <local:ValidatedTextColumn Header="Password" Binding="{Binding Password}" Width="120"/>
                <local:ValidatedTextColumn Header="Employee ID" Binding="{Binding EmployeeIdNo}" Width="100"/>
                <local:ValidatedTextColumn Header="Security Group ID" Binding="{Binding SecurityGroupIDNo}" Width="120"/>
                <local:ValidatedTextColumn Header="Full Name" Binding="{Binding FullName}" Width="120"/>
                <local:ValidatedTextColumn Header="Full Name (Arabic)" Binding="{Binding FullNameAra}" Width="120"/>
                <local:ValidatedTextColumn Header="Security Level" Binding="{Binding SecurityLevel}" Width="100"/>
                <local:ValidatedTextColumn Header="Active" Binding="{Binding Active}" Width="80"/>
                <local:ValidatedTextColumn Header="DateTimeStamp" Binding="{Binding DateTimeStamp}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>