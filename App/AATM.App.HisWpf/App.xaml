<Application x:Class="AATM.App.HisWpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AATM.App.HisWpf"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- BoolToVisibilityConverter -->
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" CollapseWhenFalse="True"/>

        <!-- Validation styles (keyed) -->
        <Style x:Key="TextBoxValidationStyle" TargetType="TextBox">
            <!-- Make validation tooltip appear immediately and stay visible longer -->
            <Setter Property="ToolTipService.InitialShowDelay" Value="0"/>
            <Setter Property="ToolTipService.BetweenShowDelay" Value="0"/>
            <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="Red" BorderThickness="1" IsHitTestVisible="False">
                            <AdornedElementPlaceholder/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip"
                            Value="{Binding RelativeSource={x:Static RelativeSource.Self},
                                            Path=(Validation.Errors)[0].ErrorContent}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ComboBoxValidationStyle" TargetType="ComboBox">
            <!-- Make validation tooltip appear immediately and stay visible longer -->
            <Setter Property="ToolTipService.InitialShowDelay" Value="0"/>
            <Setter Property="ToolTipService.BetweenShowDelay" Value="0"/>
            <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <DockPanel LastChildFill="True" IsHitTestVisible="False">
                            <TextBlock Foreground="Red" Margin="0,0,5,0"
                                   Text="{Binding [0].ErrorContent, RelativeSource={RelativeSource AncestorType=AdornedElementPlaceholder}}"/>
                            <AdornedElementPlaceholder/>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PasswordBox validation (implicit; only one per TargetType) -->
        <Style TargetType="PasswordBox">
            <!-- Make validation tooltip appear immediately and stay visible longer -->
            <Setter Property="ToolTipService.InitialShowDelay" Value="0"/>
            <Setter Property="ToolTipService.BetweenShowDelay" Value="0"/>
            <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <DockPanel LastChildFill="True" IsHitTestVisible="False">
                            <TextBlock Foreground="Red" Margin="0,0,5,0"
                                   Text="{Binding [0].ErrorContent, RelativeSource={RelativeSource AncestorType=AdornedElementPlaceholder}}"/>
                            <AdornedElementPlaceholder/>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Restore implicit styles so they apply to generated controls (e.g., DataGrid editing TextBox/ComboBox) -->
        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource TextBoxValidationStyle}">
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource ComboBoxValidationStyle}">
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- DataGrid error visuals: show first error as tooltip on the cell and add visual cue -->
        <Style x:Key="ErrorCellStyle" TargetType="{x:Type DataGridCell}">
            <Setter Property="ToolTipService.InitialShowDelay" Value="0" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="Red"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Background" Value="#FFFDECEC"/>
                    <Setter Property="ToolTip">
                        <Setter.Value>
                            <ToolTip>
                                <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=ToolTip}, Path=PlacementTarget.(Validation.Errors)[0].ErrorContent}"/>
                            </ToolTip>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Editing TextBox in DataGrid should inherit validation ToolTip logic and add border styling -->
        <Style x:Key="DataGridCellErrorStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource TextBoxValidationStyle}">
            <!-- Make validation tooltip appear immediately and stay visible longer during edit -->
            <Setter Property="ToolTipService.InitialShowDelay" Value="0"/>
            <Setter Property="ToolTipService.BetweenShowDelay" Value="0"/>
            <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
            <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip"
                            Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
                    <Setter Property="BorderBrush" Value="Red" />
                    <Setter Property="BorderThickness" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DataGridTextBlockErrorStyle" TargetType="{x:Type TextBlock}">
            <!-- Make validation tooltip appear immediately and stay visible longer in display mode -->
            <Setter Property="ToolTipService.InitialShowDelay" Value="0"/>
            <Setter Property="ToolTipService.BetweenShowDelay" Value="0"/>
            <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip"
                            Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
