<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>

	<appSettings>
		<!-- Temporary mitigation: bypass certificate validation -->
		<add key="DatabaseConnectionString" value="Server=Ibn-Server;Database=IspData;User Id=iGroupAdmin;Password=igss@123;Encrypt=True;TrustServerCertificate=True;" />
		<add key="LogLevel" value="Debug" />
		<add key="LanguageCode" value="ar-SA" />
	</appSettings>

	<connectionStrings>
		<!-- Apply the same to every connection that hits SQL Server -->
		<add name="DatabaseConnectionString" connectionString="Server=Ibn-Server;Database=IspData;User Id=iGroupAdmin;Password=igss@123;Encrypt=True;TrustServerCertificate=True;" />
		<add name="LocalizationDb" connectionString="Server=Ibn-Server;Database=IspData;User Id=iGroupAdmin;Password=igss@123;Encrypt=True;TrustServerCertificate=True;" providerName="System.Data.SqlClient" />
	</connectionStrings>

	<system.diagnostics>
		<sources>
			<source name="DefaultSource" switchName="DefaultSwitch">
				<listeners>
					<add name="FileLog" />
				</listeners>
			</source>
		</sources>
		<switches>
			<add name="DefaultSwitch" value="Information" />
		</switches>
		<sharedListeners>
			<add name="FileLog" type="Microsoft.VisualBasic.Logging.FileLogTraceListener, Microsoft.VisualBasic, Version=8.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL" initializeData="FileLogWriter" />
		</sharedListeners>
	</system.diagnostics>

	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<!-- Add bindingRedirects here only if needed -->
		</assemblyBinding>
	</runtime>
</configuration>