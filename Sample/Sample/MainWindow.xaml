<Window x:Class="FilteredComboBoxDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Filtered ComboBox Demo" Height="250" Width="400">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Type to filter the ComboBox:"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>
            <ComboBox x:Name="comboBox"
                      Width="250"
                      IsEditable="True"
                      StaysOpenOnEdit="True"
                      IsTextSearchEnabled="False" />
        </StackPanel>
    </Grid>
</Window>
