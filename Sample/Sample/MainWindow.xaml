<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WpfApp1"
        Title="FilteredCombo Demo" Height="250" Width="420"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Search fruits" FontWeight="Bold" Margin="0,0,0,6"/>
            <!-- Use the reusable control -->
            <local:FilteredComboBox x:Name="smartCombo" Height="40" ItemSelected="SmartCombo_ItemSelected"/>
        </StackPanel>
    </Grid>
</Window>
