<UserControl x:Class="YourNamespace.FilteredComboBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="36" Width="250">

    <Grid>
        <!-- Main border --> 
        <Border x:Name="RootBorder"
                Background="White"
                CornerRadius="6"
                BorderBrush="#D0D7DE"
                BorderThickness="1"
                Padding="0"
                SnapsToDevicePixels="True">
            <Grid>
                <!-- TextBox -->
                <TextBox x:Name="txtFilter"
                         Margin="0,0,36,0"
                         Padding="8,4"
                         BorderThickness="0"
                         VerticalContentAlignment="Center"
                         FontSize="14"
                         TextChanged="txtFilter_TextChanged"
                         PreviewKeyDown="txtFilter_PreviewKeyDown"
                         GotFocus="txtFilter_GotFocus"
                         LostFocus="txtFilter_LostFocus"/>

                <!-- Placeholder -->
                <TextBlock x:Name="txtPlaceholder"
                           Text="Type to search..."
                           Foreground="#999"
                           Margin="12,0,36,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="Visible"/>

                <!-- Dropdown Arrow Button -->
                <Button x:Name="btnDropdown"
                        Width="34"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Padding="0"
                        Click="btnDropdown_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder"
                                    Background="Transparent"
                                    CornerRadius="0,6,6,0"
                                    BorderBrush="Transparent"
                                    BorderThickness="0">
                                <Grid>
                                    <Rectangle Fill="Transparent"/>
                                    <Path x:Name="arrowPath"
                                          Data="M0,0 L4,4 L8,0 Z"
                                          Fill="#666"
                                          Stretch="Uniform"
                                          Width="10"
                                          Height="6"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="0"/>
                                        </Path.RenderTransform>
                                    </Path>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- Hover -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#F2F4F7"/>
                                    <Setter TargetName="arrowPath" Property="Fill" Value="#333"/>
                                </Trigger>
                                <!-- Pressed -->
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#E6E8EB"/>
                                    <Setter TargetName="arrowPath" Property="Fill" Value="#222"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Popup dropdown -->
        <Popup x:Name="popupSuggestions"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=RootBorder}"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="None"
               Opened="PopupSuggestions_Opened"
               Closed="PopupSuggestions_Closed"
               Width="{Binding ActualWidth, ElementName=RootBorder}"
               HorizontalOffset="-1">
            <Border x:Name="popupBorder"
                    Background="White"
                    CornerRadius="0,0,6,6"
                    BorderBrush="#DDD"
                    BorderThickness="1"
                    Opacity="0"
                    RenderTransformOrigin="0.5,0">
                <Border.RenderTransform>
                    <TranslateTransform Y="-5"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25"/>
                </Border.Effect>

                <ListBox x:Name="listBoxSuggestions"
                         MinHeight="40"
                         MaxHeight="200"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         MouseLeftButtonUp="listBoxSuggestions_MouseLeftButtonUp"
                         SelectionChanged="listBoxSuggestions_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,3"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="Black"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4"
                                                Margin="2,1">
                                            <ContentPresenter HorizontalAlignment="Left"
                                                              VerticalAlignment="Center"
                                                              Margin="6,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F5F7FA"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#E6F2FF"/>
                                                <Setter Property="Foreground" Value="#0066CC"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>
        </Popup>
    </Grid>
</UserControl>
